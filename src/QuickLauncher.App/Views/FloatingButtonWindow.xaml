<Window x:Class="QuickLauncher.App.Views.FloatingButtonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:QuickLauncher.App.Views"
        Title="速动悬浮球"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="58" Height="58"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize">

    <Grid>
        <!-- 外层环境光晕 -->
        <Ellipse Width="54" Height="54" Fill="{DynamicResource Brush.Bloom1}" Opacity="0.45" IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="10"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- 悬浮球体 -->
        <Ellipse x:Name="Ball" Width="46" Height="46"
                 Fill="{DynamicResource Brush.Gradient}"
                 Stroke="{DynamicResource Brush.GlassHighlight}" StrokeThickness="1.2"
                 Cursor="Hand"
                 MouseLeftButtonDown="Ball_MouseLeftButtonDown"
                 MouseLeftButtonUp="Ball_MouseLeftButtonUp"
                 MouseMove="Ball_MouseMove"
                 MouseRightButtonUp="Ball_MouseRightButtonUp">
            <Ellipse.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.55" Color="#000000"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- 顶部高光弧面 -->
        <Ellipse Width="24" Height="14" Fill="#55FFFFFF"
                 HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"
                 IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="4"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- 闪电图标 -->
        <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False">
            <Path Fill="White" Data="M 15,4.8 L 5.4,15 L 10.6,15 L 9,19.2 L 18.6,9 L 13.2,9 Z">
                <Path.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.35" Color="#000000"/>
                </Path.Effect>
            </Path>
        </Viewbox>
    </Grid>
</Window>
