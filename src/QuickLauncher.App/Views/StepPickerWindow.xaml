<Window x:Class="QuickLauncher.App.Views.StepPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择步骤类型" Width="420" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.BgBase}">

    <DockPanel Margin="16">
        <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Background="{StaticResource Brush.BgCardHover}" Foreground="White"
                 BorderThickness="0" Padding="8,7" Margin="0,0,0,10"
                 TextChanged="SearchBox_TextChanged"/>
        <TreeView x:Name="CategoryTree" Background="{StaticResource Brush.BgCard}" BorderThickness="0"
                  Foreground="{StaticResource Brush.TextPrimary}" MouseDoubleClick="CategoryTree_MouseDoubleClick">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding Display}" Margin="2,3"/>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="确定" IsDefault="True" Click="OkButton_Click"
                    Width="80" Height="28" Margin="0,0,8,0"
                    Background="{StaticResource Brush.Gradient}" Foreground="White" BorderThickness="0"/>
            <Button Content="取消" IsCancel="True"
                    Width="80" Height="28" Background="{StaticResource Brush.BgCardHover}" Foreground="{StaticResource Brush.TextSecondary}" BorderThickness="0"/>
        </StackPanel>
    </DockPanel>
</Window>
