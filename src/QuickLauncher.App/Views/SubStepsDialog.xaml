<Window x:Class="QuickLauncher.App.Views.SubStepsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:QuickLauncher.App.Views"
        Title="子步骤编辑" Width="540" Height="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent"
        Template="{StaticResource DialogShell}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" GlassFrameThickness="0"
                            CornerRadius="16" ResizeBorderThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Click="AddButton_Click" Style="{StaticResource Btn.Primary}"
                    Padding="14,7" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <views:IconView Kind="Plus" Size="14"/>
                    <TextBlock Text="添加子步骤" Margin="6,0,0,0"/>
                </StackPanel>
            </Button>
            <Button Click="DeleteButton_Click" Style="{StaticResource Btn.Danger}" Padding="14,7">
                <StackPanel Orientation="Horizontal">
                    <views:IconView Kind="Trash" Size="14"/>
                    <TextBlock Text="删除" Margin="6,0,0,0"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- 提示 -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.Tile}" CornerRadius="10"
                BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1"
                Padding="12,8" Margin="0,0,0,12">
            <TextBlock x:Name="HintText" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- 子步骤列表 -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.BgCard}"
                BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1" CornerRadius="12" Padding="6">
            <ListBox x:Name="ChildrenList" Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource Brush.TextPrimary}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="34" Height="34" CornerRadius="9"
                                    Background="{DynamicResource Brush.Tile}"
                                    BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <views:IconView Kind="Layers" Size="15" Foreground="{DynamicResource Brush.Brand}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.TextPrimary}"/>
                                <TextBlock Text="{Binding Summary}" FontSize="11"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="完成" IsDefault="True" Click="DoneButton_Click"
                    Style="{StaticResource DialogPrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>