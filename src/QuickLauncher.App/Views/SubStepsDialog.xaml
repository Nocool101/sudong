<Window x:Class="QuickLauncher.App.Views.SubStepsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="子步骤编辑" Width="520" Height="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.BgBase}">

    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="完成" IsDefault="True" Click="DoneButton_Click"
                    Width="80" Height="30" Margin="0,0,8,0"
                    Background="{StaticResource Brush.Gradient}" Foreground="White" BorderThickness="0"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="＋ 添加" Click="AddButton_Click"
                    Background="{StaticResource Brush.Gradient}" Foreground="White" BorderThickness="0"
                    Padding="12,5" Margin="0,0,8,0" Cursor="Hand"/>
            <Button Content="删除" Click="DeleteButton_Click"
                    Background="{StaticResource Brush.BgCardHover}" Foreground="{StaticResource Brush.Danger}" BorderThickness="0"
                    Padding="12,5" Cursor="Hand"/>
        </StackPanel>

        <TextBlock x:Name="HintText" DockPanel.Dock="Top" Foreground="{StaticResource Brush.TextMuted}" FontSize="11"
                   TextWrapping="Wrap" Margin="0,0,0,8"/>

        <ListBox x:Name="ChildrenList" Background="{StaticResource Brush.BgCard}" BorderThickness="0" Foreground="{StaticResource Brush.TextPrimary}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,5">
                        <TextBlock Text="{Binding DisplayName}" FontSize="13" Foreground="{StaticResource Brush.TextPrimary}"/>
                        <TextBlock Text="{Binding Summary}" FontSize="10" Foreground="{StaticResource Brush.TextMuted}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
