<Window x:Class="QuickLauncher.App.Views.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="速动"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        AllowDrop="True" Drop="PanelWindow_Drop" DragOver="PanelWindow_DragOver"
        ShowActivated="False"
        ResizeMode="NoResize"
        Width="436"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseWheel="Window_PreviewMouseWheel">

    <Window.Resources>
        <!-- 动作磁贴 -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Width" Value="94"/>
            <Setter Property="Height" Value="70"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="#17FFFFFF"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11" SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="Overlay" Background="Transparent" CornerRadius="11"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="#1FFFFFFF"/>
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Brand}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="#2AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 扁平图标/文字按钮（顶栏、翻页） -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1AFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 渐变描边 + 深色面板 -->
    <Border CornerRadius="15" Background="{StaticResource Brush.Gradient}" Padding="1" Opacity="0.98">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.55"/>
        </Border.Effect>
        <Border CornerRadius="14" Background="#F00F1218">
            <DockPanel Margin="0,0,0,8">

                <!-- 上区标题栏（全局） -->
                <DockPanel DockPanel.Dock="Top" Margin="12,9,10,5">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SettingsButton" Content="⚙" Click="SettingsButton_Click"
                                Style="{StaticResource FlatButton}" FontFamily="Segoe UI Symbol"
                                FontSize="14" Padding="7,3" ToolTip="面板设置"/>
                        <Button x:Name="CloseButton" Content="✕" Click="CloseButton_Click"
                                Style="{StaticResource FlatButton}" FontSize="12" Padding="7,3"
                                ToolTip="关闭面板"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/assets/logo.png" Width="16" Height="16"
                               VerticalAlignment="Center"/>
                        <TextBlock x:Name="GlobalTitleText" Text="速动 · 全局"
                                   Foreground="{StaticResource Brush.TextSecondary}" FontSize="12"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- 搜索框 -->
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="12,2,12,8"
                         Tag="搜索动作…"
                         BorderBrush="{StaticResource Brush.Stroke}"
                         TextChanged="SearchBox_TextChanged"
                         KeyDown="SearchBox_KeyDown"/>

                <!-- 双区内容：上区全局 + 下区上下文（禁用滚动条，一屏全显） -->
                <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <UniformGrid x:Name="GlobalGrid" Columns="4" Margin="8,0,8,2"
                                     MouseEnter="ZoneGrid_MouseEnter"/>
                        <Border x:Name="ZoneSeparator" Height="1" Background="#1FFFFFFF"
                                Margin="8,7,8,7"/>
                        <TextBlock x:Name="ContextTitleText" Foreground="{StaticResource Brush.TextMuted}" FontSize="11.5"
                                   Margin="12,0,12,5"/>
                        <UniformGrid x:Name="ContextGrid" Columns="4" Margin="8,0,8,2"
                                     MouseEnter="ZoneGrid_MouseEnter"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- 底栏 -->
                <DockPanel DockPanel.Dock="Bottom" Margin="12,5,10,0">
                    <TextBlock x:Name="PageInfoText" Text="1 / 1" Foreground="{StaticResource Brush.TextMuted}" FontSize="11"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="PrevPageButton" Content="‹ 上一页" Click="PrevPageButton_Click"
                                Style="{StaticResource FlatButton}" FontSize="11"/>
                        <Button x:Name="NextPageButton" Content="下一页 ›" Click="NextPageButton_Click"
                                Style="{StaticResource FlatButton}" FontSize="11"/>
                    </StackPanel>
                </DockPanel>

            </DockPanel>
        </Border>
    </Border>
</Window>
