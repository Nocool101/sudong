<Window x:Class="QuickLauncher.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="速动"
        Icon="pack://application:,,,/assets/app.ico"
        Width="1020" Height="680" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.BgBase}">

    <Window.Resources>
        <!-- 导航按钮：左竖条(选中) + 图标 + 文字；选中态由 Tag="Active" 驱动 -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="9"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- 选中指示条 -->
                                <Border x:Name="Bar" Grid.Column="0" Width="3.5" Height="20" CornerRadius="2"
                                        Background="{StaticResource Brush.Gradient}"
                                        VerticalAlignment="Center" Visibility="Hidden"/>
                                <ContentPresenter Grid.Column="1" Margin="14,0,10,0"
                                                  VerticalAlignment="Center" HorizontalAlignment="Left"
                                                  RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource Brush.GradientSoft}"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ============ 左侧导航栏 ============ -->
        <Border DockPanel.Dock="Left" Width="222" Background="{StaticResource Brush.BgSide}">
            <DockPanel>
                <!-- Logo / 应用名 -->
                <StackPanel DockPanel.Dock="Top" Margin="18,22,18,10">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/assets/logo.png" Width="36" Height="36"/>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="速动" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource Brush.TextPrimary}"/>
                            <TextBlock Text="全局效率操作面板" FontSize="11"
                                       Foreground="{StaticResource Brush.TextMuted}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 导航项 -->
                <StackPanel DockPanel.Dock="Top" Margin="10,10,10,0">
                    <Button x:Name="NavActions" Click="NavActions_Click" Style="{StaticResource NavButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" FontFamily="Segoe UI Symbol" FontSize="15" Width="22" TextAlignment="Center"/>
                            <TextBlock Text="动作管理" FontSize="13.5" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavScenes" Click="NavScenes_Click" Style="{StaticResource NavButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▤" FontFamily="Segoe UI Symbol" FontSize="15" Width="22" TextAlignment="Center"/>
                            <TextBlock Text="场景管理" FontSize="13.5" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavCommands" Click="NavCommands_Click" Style="{StaticResource NavButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌨" FontFamily="Segoe UI Symbol" FontSize="15" Width="22" TextAlignment="Center"/>
                            <TextBlock Text="指令管理" FontSize="13.5" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavHotkeys" Click="NavHotkeys_Click" Style="{StaticResource NavButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✦" FontFamily="Segoe UI Symbol" FontSize="15" Width="22" TextAlignment="Center"/>
                            <TextBlock Text="扩展热键" FontSize="13.5" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavSettings" Click="NavSettings_Click" Style="{StaticResource NavButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontFamily="Segoe UI Symbol" FontSize="15" Width="22" TextAlignment="Center"/>
                            <TextBlock Text="设置" FontSize="13.5" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 底部提示 -->
                <StackPanel DockPanel.Dock="Bottom" Margin="18,0,18,16">
                    <Border Height="1" Background="{StaticResource Brush.Stroke}" Margin="0,0,0,12"/>
                    <TextBlock Text="单击鼠标中键 / 快击 Ctrl" FontSize="11"
                               Foreground="{StaticResource Brush.TextMuted}"/>
                    <TextBlock Text="随时唤出操作面板" FontSize="11"
                               Foreground="{StaticResource Brush.TextMuted}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ 右侧内容区 ============ -->
        <ContentControl x:Name="ContentArea" Margin="0"/>
    </DockPanel>
</Window>
