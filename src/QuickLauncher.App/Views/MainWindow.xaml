<Window x:Class="QuickLauncher.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:QuickLauncher.App.Views"
        Title="速动"
        Icon="pack://application:,,,/QuickLauncher.App;component/assets/app.ico"
        Width="1080" Height="720" MinWidth="920" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Brush.BgBase}"
        UseLayoutRounding="True">

    <!-- 自定义窗口框架：自绘标题栏 + 圆角 + 毛玻璃背板 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" GlassFrameThickness="0"
                            CornerRadius="16" ResizeBorderThickness="6"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 导航按钮：胶囊圆角 + 选中指示条 + 矢量图标 + 文字 -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="10,2.5"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3.5"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- 选中指示条 -->
                                <Border x:Name="Bar" Grid.Column="0" Width="3.5" Height="22" CornerRadius="2"
                                        Background="{DynamicResource Brush.Gradient}"
                                        VerticalAlignment="Center" Visibility="Hidden"/>
                                <ContentPresenter Grid.Column="1" Margin="14,0,10,0"
                                                  VerticalAlignment="Center" HorizontalAlignment="Left"
                                                  RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Brush.HoverOverlay}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Brush.GradientSoft}"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标题栏按钮：关闭按钮 hover 变红（Win11 习惯） -->
        <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource Btn.Caption}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="Overlay" Background="Transparent"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="#E0FB7185"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid ClipToBounds="True">
        <!-- ═════════ 极光背景：玻璃背后的彩色柔光 ═════════ -->
        <Ellipse Width="760" Height="760" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-240,-280,0,0" Fill="{DynamicResource Brush.Bloom1}" Opacity="0.32"
                 IsHitTestVisible="False"/>
        <Ellipse Width="680" Height="680" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-220,-200,0" Fill="{DynamicResource Brush.Bloom2}" Opacity="0.30"
                 IsHitTestVisible="False"/>
        <Ellipse Width="820" Height="820" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                 Margin="0,0,0,-450" Fill="{DynamicResource Brush.Bloom3}" Opacity="0.18"
                 IsHitTestVisible="False"/>

        <!-- ═════════ 玻璃面板外壳 ═════════ -->
        <Border x:Name="RootPanel" CornerRadius="16" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1">
            <DockPanel>

                <!-- ═════════ 标题栏 ═════════ -->
                <Grid DockPanel.Dock="Top" Height="56">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <!-- 图标徽章 -->
                        <Border Width="34" Height="34" CornerRadius="10"
                                Background="{DynamicResource Brush.GradientSoft}"
                                BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1">
                            <Image Source="pack://application:,,,/QuickLauncher.App;component/assets/logo.png"
                                   Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock Text="速动" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   VerticalAlignment="Center" Margin="11,0,8,0"/>
                        <!-- 胶囊副标 -->
                        <Border Background="{DynamicResource Brush.Tile}" BorderBrush="{DynamicResource Brush.Stroke}"
                                BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="QuickLauncher" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Brand}"/>
                        </Border>
                        <Border Width="1" Height="14" Background="{DynamicResource Brush.Stroke}"
                                VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="全局效率操作面板" FontSize="11.5"
                                   Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <!-- 状态胶囊 -->
                        <Border Background="#1434D399" BorderBrush="#3034D399" BorderThickness="1"
                                CornerRadius="12" Padding="10,3.5" Margin="0,0,14,0" VerticalAlignment="Center"
                                IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Accent}" Margin="0,0,6,0"/>
                                <TextBlock Text="全局监听已就绪" FontSize="11" FontWeight="Medium"
                                           Foreground="{DynamicResource Brush.Accent}"/>
                            </StackPanel>
                        </Border>

                        <!-- 窗口控制按钮 -->
                        <Button x:Name="MinimizeButton" Style="{StaticResource Btn.Caption}"
                                Click="MinimizeButton_Click" ToolTip="最小化"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <views:IconView Kind="Minimize" Size="14"/>
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource Btn.Caption}"
                                Click="MaximizeButton_Click" ToolTip="最大化"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <views:IconView Kind="Maximize" Size="13"/>
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource CaptionClose}"
                                Click="CloseButton_Click" ToolTip="关闭"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <views:IconView Kind="Close" Size="13"/>
                        </Button>
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource Brush.Stroke}"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="236"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ═════════ 左侧导航栏 ═════════ -->
                    <Border Grid.Column="0" Background="{DynamicResource Brush.BgSide}">
                        <Border BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="0,0,1,0">
                            <DockPanel>

                                <!-- 底部唤出提示卡片 -->
                                <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Tile}"
                                        BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1"
                                        CornerRadius="12" Padding="12,11" Margin="14,0,14,16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <views:IconView Kind="Bolt" Size="13" Foreground="{DynamicResource Brush.Brand}"/>
                                            <TextBlock Text="快捷唤出" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.TextPrimary}" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                            <Border Style="{StaticResource Kbd}" Margin="0,0,4,0">
                                                <TextBlock Text="鼠标中键" Style="{StaticResource KbdText}"/>
                                            </Border>
                                            <TextBlock Text="/" Foreground="{DynamicResource Brush.TextMuted}"
                                                       VerticalAlignment="Center" Margin="2,0,6,0"/>
                                            <Border Style="{StaticResource Kbd}">
                                                <TextBlock Text="快击 Ctrl" Style="{StaticResource KbdText}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="在任意窗口直接呼出面板" FontSize="10.5"
                                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                                    </StackPanel>
                                </Border>

                                <!-- 导航分类与项目 -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="0,8,0,0">
                                        <!-- 分组 1: 核心功能 -->
                                        <TextBlock Text="核心操作" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                   Margin="18,10,18,5"/>
                                        <Button x:Name="NavActions" Click="NavActions_Click" Style="{StaticResource NavButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <views:IconView Kind="Bolt" Size="16"/>
                                                <TextBlock Text="动作管理" FontSize="13.5" Margin="11,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="NavScenes" Click="NavScenes_Click" Style="{StaticResource NavButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <views:IconView Kind="Layers" Size="16"/>
                                                <TextBlock Text="场景管理" FontSize="13.5" Margin="11,0,0,0"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- 分组 2: 触发方式 -->
                                        <TextBlock Text="快捷触发" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                   Margin="18,14,18,5"/>
                                        <Button x:Name="NavCommands" Click="NavCommands_Click" Style="{StaticResource NavButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <views:IconView Kind="Terminal" Size="16"/>
                                                <TextBlock Text="指令管理" FontSize="13.5" Margin="11,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="NavHotkeys" Click="NavHotkeys_Click" Style="{StaticResource NavButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <views:IconView Kind="Sparkles" Size="16"/>
                                                <TextBlock Text="扩展热键" FontSize="13.5" Margin="11,0,0,0"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- 分组 3: 系统偏好 -->
                                        <TextBlock Text="首选项" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                   Margin="18,14,18,5"/>
                                        <Button x:Name="NavSettings" Click="NavSettings_Click" Style="{StaticResource NavButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <views:IconView Kind="Sliders" Size="16"/>
                                                <TextBlock Text="设置" FontSize="13.5" Margin="11,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Border>

                    <!-- ═════════ 右侧内容区 ═════════ -->
                    <ContentControl x:Name="ContentArea" Grid.Column="1" Margin="0"/>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
