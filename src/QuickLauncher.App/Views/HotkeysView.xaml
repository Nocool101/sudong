<UserControl x:Class="QuickLauncher.App.Views.HotkeysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:QuickLauncher.App.Views"
             Background="Transparent">

    <DockPanel Margin="28,24,28,24">
        <!-- ═════════ 页头 ═════════ -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="扩展热键" Style="{StaticResource Text.PageTitle}"/>
                <TextBlock Text="通过引导键 + 动作键触发动作，支持修饰键组合"
                           Style="{StaticResource Text.PageSubtitle}" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Click="NewHotkeyButton_Click" Grid.Column="1"
                    Style="{StaticResource Btn.Primary}" VerticalAlignment="Top" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <views:IconView Kind="Plus" Size="15"/>
                    <TextBlock Text="新建扩展热键" Margin="7,0,0,0"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ═════════ 工具栏 ═════════ -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
            <Button Click="DeleteHotkeyButton_Click" Style="{StaticResource Btn.Danger}">
                <StackPanel Orientation="Horizontal">
                    <views:IconView Kind="Trash" Size="14"/>
                    <TextBlock Text="删除" Margin="6,0,0,0"/>
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                <views:IconView Kind="Info" Size="13" Foreground="{DynamicResource Brush.TextMuted}"/>
                <TextBlock Text="引导键 + 动作键（可加修饰键）。单独快速按引导键可触发空动作键条目。"
                           Foreground="{DynamicResource Brush.TextMuted}" FontSize="12"
                           Margin="7,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- ═════════ 热键列表（卡片） ═════════ -->
        <Border Background="{DynamicResource Brush.BgCard}" BorderBrush="{DynamicResource Brush.Stroke}"
                BorderThickness="1" CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.08" Color="#000000"/>
            </Border.Effect>
            <ListBox x:Name="HotkeysList" Background="Transparent" BorderThickness="0" Padding="8"
                     HorizontalContentAlignment="Stretch"
                     MouseDoubleClick="HotkeysList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="10,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 组合键做成键盘样式徽章 -->
                            <Border Grid.Column="0" CornerRadius="10" Padding="14,8" MinWidth="86"
                                    Background="{DynamicResource Brush.GradientSoft}"
                                    BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <views:IconView Kind="Keyboard" Size="14"
                                                    Foreground="{DynamicResource Brush.Brand}"/>
                                    <TextBlock Text="{Binding Keys}" FontSize="13.5" Margin="8,0,0,0"
                                               Foreground="{DynamicResource Brush.Brand}" FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="执行动作：" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ActionName}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="按下引导组合键后立即触发执行" FontSize="11.5"
                                           Foreground="{DynamicResource Brush.TextMuted}" Margin="0,3,0,0"/>
                            </StackPanel>

                            <views:IconView Grid.Column="2" Kind="ChevronRight" Size="13"
                                            Foreground="{DynamicResource Brush.TextMuted}" Opacity="0.6"
                                            VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</UserControl>
