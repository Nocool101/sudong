<UserControl x:Class="QuickLauncher.App.Views.TextCommandsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:QuickLauncher.App.Views"
             Background="Transparent">

    <DockPanel Margin="28,24,28,24">
        <!-- ═════════ 页头 ═════════ -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="指令管理" Style="{StaticResource Text.PageTitle}"/>
                <TextBlock Text="输入缩写词加触发字符，快速执行对应动作"
                           Style="{StaticResource Text.PageSubtitle}" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Click="NewCommandButton_Click" Grid.Column="1"
                    Style="{StaticResource Btn.Primary}" VerticalAlignment="Top" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <views:IconView Kind="Plus" Size="15"/>
                    <TextBlock Text="新建指令" Margin="7,0,0,0"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ═════════ 工具栏 ═════════ -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
            <Button Click="DeleteCommandButton_Click" Style="{StaticResource Btn.Danger}">
                <StackPanel Orientation="Horizontal">
                    <views:IconView Kind="Trash" Size="14"/>
                    <TextBlock Text="删除" Margin="6,0,0,0"/>
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                <views:IconView Kind="Info" Size="13" Foreground="{DynamicResource Brush.TextMuted}"/>
                <TextBlock Text="输入缩写词后按触发字符（默认 Tab）即可快速执行动作"
                           Foreground="{DynamicResource Brush.TextMuted}" FontSize="12"
                           Margin="7,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- ═════════ 指令列表（卡片） ═════════ -->
        <Border Background="{DynamicResource Brush.BgCard}" BorderBrush="{DynamicResource Brush.Stroke}"
                BorderThickness="1" CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.08" Color="#000000"/>
            </Border.Effect>
            <ListBox x:Name="CommandsList" Background="Transparent" BorderThickness="0" Padding="8"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="10,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 缩写词按键卡片 -->
                            <Border Grid.Column="0" CornerRadius="10" Padding="14,8" MinWidth="72"
                                    Background="{DynamicResource Brush.GradientSoft}"
                                    BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <views:IconView Kind="Terminal" Size="13" Foreground="{DynamicResource Brush.Brand}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Abbreviation}" FontSize="13.5"
                                               Foreground="{DynamicResource Brush.Brand}" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="执行动作：" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ActionName}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="输入此缩写后按 Tab 键立即触发" FontSize="11.5"
                                           Foreground="{DynamicResource Brush.TextMuted}" Margin="0,3,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="2" Style="{StaticResource Kbd}" VerticalAlignment="Center">
                                <TextBlock Text="Tab 触发" Style="{StaticResource KbdText}"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</UserControl>
