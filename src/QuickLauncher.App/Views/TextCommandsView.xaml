<UserControl x:Class="QuickLauncher.App.Views.TextCommandsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Brush.BgBase}">

    <DockPanel Margin="24">
        <!-- 页头 -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="指令管理" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource Brush.TextPrimary}"/>
            <TextBlock Text="输入缩写词加触发字符，快速执行对应动作" FontSize="12"
                       Foreground="{StaticResource Brush.TextMuted}" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- 工具栏 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
            <Button Content="＋ 新建指令" Click="NewCommandButton_Click"
                    Style="{StaticResource Btn.Primary}" Margin="0,0,8,0"/>
            <Button Content="删除" Click="DeleteCommandButton_Click" Style="{StaticResource Btn.Danger}"/>
            <TextBlock Text="提示：输入缩写词后按触发字符（默认 Tab）执行"
                       Foreground="{StaticResource Brush.TextMuted}" FontSize="11.5"
                       VerticalAlignment="Center" Margin="16,0,0,0"/>
        </StackPanel>

        <!-- 指令列表（卡片容器） -->
        <Border Background="{StaticResource Brush.BgCard}" BorderBrush="{StaticResource Brush.Stroke}"
                BorderThickness="1" CornerRadius="12">
            <ListBox x:Name="CommandsList" Background="Transparent" BorderThickness="0" Padding="6"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="6,7">
                            <TextBlock Text="{Binding Abbreviation}" FontSize="14"
                                       Foreground="{StaticResource Brush.Brand}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ActionName}" FontSize="11.5"
                                       Foreground="{StaticResource Brush.TextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</UserControl>
