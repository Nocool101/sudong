<UserControl x:Class="QuickLauncher.App.Views.ScenesManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Brush.BgBase}">

    <DockPanel Margin="24">
        <!-- 页头 -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="场景管理" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource Brush.TextPrimary}"/>
            <TextBlock Text="为不同应用程序配置专用动作页，面板会自动识别当前程序" FontSize="12"
                       Foreground="{StaticResource Brush.TextMuted}" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- 工具栏 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
            <Button Content="＋ 新建场景" Click="NewSceneButton_Click"
                    Style="{StaticResource Btn.Primary}" Margin="0,0,8,0"/>
            <Button Content="编辑" Click="EditSceneButton_Click" Margin="0,0,8,0"/>
            <Button Content="删除" Click="DeleteSceneButton_Click" Style="{StaticResource Btn.Danger}"/>
        </StackPanel>

        <!-- 场景列表（卡片容器） -->
        <Border Background="{StaticResource Brush.BgCard}" BorderBrush="{StaticResource Brush.Stroke}"
                BorderThickness="1" CornerRadius="12">
            <ListBox x:Name="ScenesList" Background="Transparent" BorderThickness="0" Padding="6"
                     HorizontalContentAlignment="Stretch"
                     MouseDoubleClick="ScenesList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="6,7">
                            <TextBlock Text="{Binding Name}" FontSize="13.5"
                                       Foreground="{StaticResource Brush.TextPrimary}"/>
                            <TextBlock Text="{Binding MatchDescription}" FontSize="11.5"
                                       Foreground="{StaticResource Brush.TextSecondary}" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding PageDescription}" FontSize="11.5"
                                       Foreground="{StaticResource Brush.TextMuted}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</UserControl>
