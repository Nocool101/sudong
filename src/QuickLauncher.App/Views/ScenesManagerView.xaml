<UserControl x:Class="QuickLauncher.App.Views.ScenesManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:QuickLauncher.App.Views"
             Background="Transparent">

    <DockPanel Margin="28,24,28,24">
        <!-- ═════════ 页头 ═════════ -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="场景管理" Style="{StaticResource Text.PageTitle}"/>
                <TextBlock Text="为不同应用程序配置专用动作页，面板会自动识别当前程序"
                           Style="{StaticResource Text.PageSubtitle}" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Click="NewSceneButton_Click" Grid.Column="1"
                    Style="{StaticResource Btn.Primary}" VerticalAlignment="Top" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <views:IconView Kind="Plus" Size="15"/>
                    <TextBlock Text="新建场景" Margin="7,0,0,0"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ═════════ 工具栏 ═════════ -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
            <Button Click="EditSceneButton_Click" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <views:IconView Kind="Pencil" Size="14"/>
                    <TextBlock Text="编辑" Margin="6,0,0,0"/>
                </StackPanel>
            </Button>
            <Button Click="DeleteSceneButton_Click" Style="{StaticResource Btn.Danger}">
                <StackPanel Orientation="Horizontal">
                    <views:IconView Kind="Trash" Size="14"/>
                    <TextBlock Text="删除" Margin="6,0,0,0"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- ═════════ 场景列表（卡片） ═════════ -->
        <Border Background="{DynamicResource Brush.BgCard}" BorderBrush="{DynamicResource Brush.Stroke}"
                BorderThickness="1" CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.08" Color="#000000"/>
            </Border.Effect>
            <ListBox x:Name="ScenesList" Background="Transparent" BorderThickness="0" Padding="8"
                     HorizontalContentAlignment="Stretch"
                     MouseDoubleClick="ScenesList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="10,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="42" Height="42" CornerRadius="12"
                                    Background="{DynamicResource Brush.Tile}"
                                    BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1">
                                <Grid ClipToBounds="True">
                                    <Border Background="{DynamicResource Brush.Specular}" CornerRadius="12,12,0,0" Height="10" VerticalAlignment="Top"/>
                                    <views:IconView Kind="Layers" Size="20"
                                                    Foreground="{DynamicResource Brush.Brand}"
                                                    VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.TextPrimary}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Border Background="{DynamicResource Brush.Tile}" CornerRadius="5"
                                            Padding="6,2" Margin="0,0,8,0"
                                            BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1">
                                        <TextBlock Text="{Binding MatchDescription}" FontSize="11"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"/>
                                    </Border>
                                    <Border Background="{DynamicResource Brush.GradientSoft}" CornerRadius="5"
                                            Padding="6,2"
                                            BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1">
                                        <TextBlock Text="{Binding PageDescription}" FontSize="11"
                                                   Foreground="{DynamicResource Brush.Brand}"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <views:IconView Grid.Column="2" Kind="ChevronRight" Size="13"
                                            Foreground="{DynamicResource Brush.TextMuted}" Opacity="0.6"
                                            VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</UserControl>
