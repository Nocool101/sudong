<UserControl x:Class="QuickLauncher.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Brush.BgBase}">

    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.BgCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CardDesc" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26">
        <StackPanel MaxWidth="620">
            <!-- 页头 -->
            <TextBlock Text="设置" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource Brush.TextPrimary}" Margin="0,0,0,4"/>
            <TextBlock Text="个性化你的速动面板与触发方式" Style="{StaticResource CardDesc}"
                       Margin="0,0,0,20"/>

            <!-- 触发设置 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Width="4" Height="16" CornerRadius="2" Background="{StaticResource Brush.Gradient}"/>
                        <TextBlock Text="触发设置" Style="{StaticResource CardTitle}" Margin="9,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="自定义哪些鼠标按钮触发面板" Style="{StaticResource CardDesc}" Margin="0,0,0,16"/>

                    <TextBlock Text="面板触发按钮（可多选）" Foreground="{StaticResource Brush.TextSecondary}"
                               FontSize="13" Margin="0,0,0,10"/>
                    <WrapPanel Margin="0,0,0,14">
                        <CheckBox x:Name="BtnMiddle" Content="鼠标中键" Margin="0,0,18,8"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <CheckBox x:Name="BtnX1" Content="侧键 X1（后退）" Margin="0,0,18,8"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <CheckBox x:Name="BtnX2" Content="侧键 X2（前进）" Margin="0,0,18,8"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <CheckBox x:Name="BtnRight" Content="鼠标右键" Margin="0,0,18,8"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <CheckBox x:Name="BtnLeft" Content="鼠标左键（长按）" Margin="0,0,8,0"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                    </WrapPanel>

                    <CheckBox x:Name="CtrlClickBox" Content="快击 Ctrl 弹出面板"
                              Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                </StackPanel>
            </Border>

            <!-- 外观 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Width="4" Height="16" CornerRadius="2" Background="{StaticResource Brush.Gradient}"/>
                        <TextBlock Text="外观" Style="{StaticResource CardTitle}" Margin="9,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="调整面板磁贴的显示大小" Style="{StaticResource CardDesc}" Margin="0,0,0,18"/>

                    <DockPanel>
                        <TextBlock Text="面板按钮大小" Foreground="{StaticResource Brush.TextSecondary}"
                                   FontSize="13" Width="120" VerticalAlignment="Center"/>
                        <Slider x:Name="ButtonSizeSlider" Minimum="36" Maximum="80" Width="240"
                                VerticalAlignment="Center" ValueChanged="Setting_Changed"/>
                        <TextBlock x:Name="ButtonSizeText" Foreground="{StaticResource Brush.TextPrimary}"
                                   FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center" MinWidth="34"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- 常规 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Width="4" Height="16" CornerRadius="2" Background="{StaticResource Brush.Gradient}"/>
                        <TextBlock Text="常规" Style="{StaticResource CardTitle}" Margin="9,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="启动方式与运行偏好" Style="{StaticResource CardDesc}" Margin="0,0,0,16"/>

                    <CheckBox x:Name="RunAtStartupBox" Content="开机自动启动" Margin="0,0,0,12"
                              Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                    <CheckBox x:Name="TrackUsageBox" Content="记录动作使用统计" Margin="0,0,0,12"
                              Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                    <CheckBox x:Name="PlaySoundsBox" Content="播放音效" Margin="0,0,0,12"
                              Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                    <CheckBox x:Name="FloatingButtonBox" Content="显示桌面悬浮按钮（可拖动）" Margin="0,0,0,4"
                              Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                </StackPanel>
            </Border>

            <!-- 备份与恢复 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Width="4" Height="16" CornerRadius="2" Background="{StaticResource Brush.Gradient}"/>
                        <TextBlock Text="备份与恢复" Style="{StaticResource CardTitle}" Margin="9,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="一键导出/导入全部配置（动作、场景、指令、热键、设置），便于备份或迁移到新电脑"
                               Style="{StaticResource CardDesc}" Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ExportConfigButton" Content="⬇  导出配置" Click="ExportConfigButton_Click"
                                Style="{StaticResource Btn.Primary}" Margin="0,0,10,0"/>
                        <Button x:Name="ImportConfigButton" Content="⬆  导入配置" Click="ImportConfigButton_Click"
                                Style="{StaticResource Btn.Ghost}"/>
                    </StackPanel>
                    <TextBlock Text="导入将覆盖当前配置并自动重启应用；导入前会自动备份原配置。"
                               Foreground="{StaticResource Brush.TextMuted}" FontSize="11" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="SavedText" Foreground="{StaticResource Brush.Accent}" FontSize="12" Margin="2,4,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
