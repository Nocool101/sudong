<UserControl x:Class="QuickLauncher.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:QuickLauncher.App.Views"
             Background="Transparent">

    <UserControl.Resources>
        <!-- 主题分段选择器：选中项由 Tag="Selected" 驱动 -->
        <Style x:Key="SegmentButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Brush.HoverOverlay}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Brush.GradientSoft}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24,28,24">
        <StackPanel MaxWidth="680">

            <!-- ═════════ 页头 ═════════ -->
            <TextBlock Text="设置" Style="{StaticResource Text.PageTitle}"/>
            <TextBlock Text="个性化你的速动面板、交互触感与触发方式"
                       Style="{StaticResource Text.PageSubtitle}" Margin="0,5,0,22"/>

            <!-- ═════════ 外观 ═════════ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource Brush.Gradient}"/>
                        <TextBlock Text="外观与个性化" Style="{StaticResource CardTitle}" Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="控制面板视觉主题与磁贴按键大小" Style="{StaticResource CardDesc}" Margin="0,0,0,18"/>

                    <TextBlock Text="界面主题" Foreground="{DynamicResource Brush.TextSecondary}"
                               FontSize="13" Margin="0,0,0,9"/>
                    <Border Background="{DynamicResource Brush.Tile}" BorderBrush="{DynamicResource Brush.Stroke}"
                            BorderThickness="1" CornerRadius="12" Padding="4" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ThemeSystemButton" CommandParameter="System" Click="ThemeButton_Click"
                                    Style="{StaticResource SegmentButton}">
                                <StackPanel Orientation="Horizontal">
                                    <views:IconView Kind="Auto" Size="15"/>
                                    <TextBlock Text="跟随系统" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ThemeLightButton" CommandParameter="Light" Click="ThemeButton_Click"
                                    Style="{StaticResource SegmentButton}">
                                <StackPanel Orientation="Horizontal">
                                    <views:IconView Kind="Sun" Size="15"/>
                                    <TextBlock Text="浅色模式" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ThemeDarkButton" CommandParameter="Dark" Click="ThemeButton_Click"
                                    Style="{StaticResource SegmentButton}">
                                <StackPanel Orientation="Horizontal">
                                    <views:IconView Kind="Moon" Size="15"/>
                                    <TextBlock Text="深色模式" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Height="1" Background="{DynamicResource Brush.Stroke}" Margin="0,18,0,16"/>

                    <DockPanel>
                        <TextBlock Text="面板磁贴大小" Foreground="{DynamicResource Brush.TextSecondary}"
                                   FontSize="13" Width="120" VerticalAlignment="Center"/>
                        <Slider x:Name="ButtonSizeSlider" Minimum="36" Maximum="80" Width="240"
                                VerticalAlignment="Center" ValueChanged="Setting_Changed"/>
                        <TextBlock x:Name="ButtonSizeText" Foreground="{DynamicResource Brush.Brand}"
                                   FontSize="13" FontWeight="SemiBold" Margin="14,0,0,0" VerticalAlignment="Center" MinWidth="40"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ═════════ 触发设置 ═════════ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource Brush.Gradient}"/>
                        <TextBlock Text="快捷触发" Style="{StaticResource CardTitle}" Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="配置呼出面板的鼠标按键与键盘操作" Style="{StaticResource CardDesc}" Margin="0,0,0,18"/>

                    <TextBlock Text="鼠标呼出按键（可多选）" Foreground="{DynamicResource Brush.TextSecondary}"
                               FontSize="13" Margin="0,0,0,12"/>
                    <WrapPanel Margin="0,0,0,16">
                        <CheckBox x:Name="BtnMiddle" Content="鼠标中键" Margin="0,0,20,10"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <CheckBox x:Name="BtnX1" Content="侧键 X1（后退）" Margin="0,0,20,10"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <CheckBox x:Name="BtnX2" Content="侧键 X2（前进）" Margin="0,0,20,10"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <CheckBox x:Name="BtnRight" Content="鼠标右键" Margin="0,0,20,10"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <CheckBox x:Name="BtnLeft" Content="鼠标左键（长按）" Margin="0,0,8,0"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                    </WrapPanel>

                    <Border Height="1" Background="{DynamicResource Brush.Stroke}" Margin="0,4,0,14"/>

                    <CheckBox x:Name="CtrlClickBox" Content="快击 Ctrl 唤出面板（小于 200ms）"
                              Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                </StackPanel>
            </Border>

            <!-- ═════════ 常规 ═════════ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource Brush.Gradient}"/>
                        <TextBlock Text="常规与系统" Style="{StaticResource CardTitle}" Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="系统自启、后台常驻与运行细节" Style="{StaticResource CardDesc}" Margin="0,0,0,18"/>

                    <CheckBox x:Name="RunAtStartupBox" Content="开机自动启动" Margin="0,0,0,14"
                              Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                    <CheckBox x:Name="ShowMainWindowOnStartupBox"
                              Content="开机启动时显示主窗口（默认静默：仅驻留托盘）"
                              Margin="0,0,0,14"
                              Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                    <CheckBox x:Name="TrackUsageBox" Content="记录动作使用统计" Margin="0,0,0,14"
                              Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                    <CheckBox x:Name="PlaySoundsBox" Content="播放操作提示音" Margin="0,0,0,14"
                              Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                    <CheckBox x:Name="FloatingButtonBox" Content="显示桌面悬浮球（可自由拖动）" Margin="0,0,0,14"
                              Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                    <CheckBox x:Name="DebugLogBox" Content="启用调试日志（写入 %TEMP%\ql_debug.log）" Margin="0,0,0,4"
                              Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                </StackPanel>
            </Border>

            <!-- ═════════ 备份与恢复 ═════════ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource Brush.Gradient}"/>
                        <TextBlock Text="备份与恢复" Style="{StaticResource CardTitle}" Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="一键导出或导入全部配置（动作、场景、指令、热键、设置），方便迁移至新设备"
                               Style="{StaticResource CardDesc}" Margin="0,0,0,18"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ExportConfigButton" Click="ExportConfigButton_Click"
                                Style="{StaticResource Btn.Primary}" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <views:IconView Kind="Download" Size="14"/>
                                <TextBlock Text="导出配置备份" Margin="7,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ImportConfigButton" Click="ImportConfigButton_Click"
                                Style="{StaticResource Btn.Ghost}">
                            <StackPanel Orientation="Horizontal">
                                <views:IconView Kind="Upload" Size="14"/>
                                <TextBlock Text="导入配置" Margin="7,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="※ 导入将覆盖当前全部数据并自动重启应用；导入前会自动在本地保留一份历史备份。"
                               Foreground="{DynamicResource Brush.TextMuted}" FontSize="11" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="SavedText" Foreground="{DynamicResource Brush.Accent}" FontSize="12.5" Margin="4,4,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
