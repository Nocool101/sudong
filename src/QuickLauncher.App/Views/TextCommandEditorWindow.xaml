<Window x:Class="QuickLauncher.App.Views.TextCommandEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="指令编辑器" Width="440" Height="330"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.BgBase}">

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="保存" IsDefault="True" Click="SaveButton_Click"
                    Width="90" Height="32" Margin="0,0,8,0"
                    Background="{StaticResource Brush.Gradient}" Foreground="White" BorderThickness="0"/>
            <Button Content="取消" IsCancel="True"
                    Width="90" Height="32" Background="{StaticResource Brush.BgCardHover}" Foreground="{StaticResource Brush.TextSecondary}" BorderThickness="0"/>
        </StackPanel>

        <StackPanel>
            <TextBlock Text="缩写词" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="AbbrBox" Background="{StaticResource Brush.BgCardHover}" Foreground="White" BorderThickness="0"
                     Padding="8,6" Margin="0,0,0,12"/>

            <TextBlock Text="触发的动作" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
            <ComboBox x:Name="ActionCombo" Background="{StaticResource Brush.BgCardHover}" Foreground="White" BorderThickness="0"
                      Padding="8,6" Margin="0,0,0,12" DisplayMemberPath="Name" SelectedValuePath="Id"/>

            <TextBlock Text="触发字符（留空用全局默认）" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="TriggerBox" Background="{StaticResource Brush.BgCardHover}" Foreground="White" BorderThickness="0"
                     Padding="8,6" Margin="0,0,0,12"/>

            <CheckBox x:Name="EnabledBox" Content="启用" Foreground="{StaticResource Brush.TextPrimary}"/>
        </StackPanel>
    </DockPanel>
</Window>
