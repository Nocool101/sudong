<Window x:Class="QuickLauncher.App.Views.IconPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:QuickLauncher.App.Views"
        Title="选择图标" Width="500" Height="600"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent"
        Template="{StaticResource DialogShell}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" GlassFrameThickness="0"
                            CornerRadius="16" ResizeBorderThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="EmojiTileButton" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Tile}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.HoverOverlay}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Brand}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.GradientSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 预览卡片 -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.BgCard}"
                BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1" CornerRadius="14"
                Padding="14" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="PreviewBorder" Width="52" Height="52" CornerRadius="13"
                        Background="{DynamicResource Brush.Tile}"
                        BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1">
                    <Grid>
                        <TextBlock x:Name="PreviewText" Text="▶" FontSize="26"
                                   Foreground="{DynamicResource Brush.Brand}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image x:Name="PreviewImage" Width="36" Height="36"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="图标预览" Foreground="{DynamicResource Brush.TextSecondary}"
                               FontSize="11.5" FontWeight="Medium" Margin="0,0,0,3"/>
                    <TextBlock x:Name="PreviewDesc" Text="字符：▶" Foreground="{DynamicResource Brush.TextPrimary}"
                               FontSize="13" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 来源切换 -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">

            <!-- 字符 / Emoji -->
            <TabItem Header="字符 / 表情">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <WrapPanel x:Name="CharGrid" Orientation="Horizontal"/>
                </ScrollViewer>
            </TabItem>

            <!-- FontAwesome -->
            <TabItem Header="FontAwesome">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,6,0,0">
                        <TextBlock Text="图标名" Style="{StaticResource Text.FieldLabel}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="FaNameCombo" IsEditable="True" Text="Solid_Play"
                                  Margin="0,0,0,14"
                                  SelectionChanged="FaInput_Changed" LostFocus="FaInput_Changed"/>
                        <TextBlock Text="颜色" Style="{StaticResource Text.FieldLabel}" Margin="0,0,0,6"/>
                        <DockPanel Margin="0,0,0,14">
                            <TextBox x:Name="FaColorBox" Text="#FF0078D7" TextChanged="FaInput_Changed"/>
                            <Button DockPanel.Dock="Right" Click="FaColorPick_Click" Margin="8,0,0,0"
                                    Padding="14,6">
                                <TextBlock Text="取色…"/>
                            </Button>
                        </DockPanel>
                        <Border Background="{DynamicResource Brush.Tile}" BorderBrush="{DynamicResource Brush.Stroke}"
                                BorderThickness="1" CornerRadius="10" Padding="12,10">
                            <TextBlock Foreground="{DynamicResource Brush.TextMuted}" FontSize="11" TextWrapping="Wrap" LineHeight="17"
                                       Text="生成 [fa:图标名:颜色] 语法。常用名：Solid_Play、Solid_Bolt、Solid_Globe、Solid_Folder、Solid_File、Solid_Keyboard、Solid_Comment、Solid_Scroll、Solid_FileImport、Solid_Gear、Solid_Search、Solid_Lock、Solid_Thumbtack、Solid_Music、Solid_Bell、Solid_Rocket、Solid_Clock、Solid_Calendar、Solid_Bullseye、Solid_Mouse、Solid_Desktop、Solid_Link、Solid_Exclamation、Solid_Heart、Solid_Star、Solid_Envelope、Solid_Trash、Solid_ArrowDown、Solid_ArrowUp、Solid_Pause、Solid_Redo"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 应用程序 / 库文件：提取真实应用图标 -->
            <TabItem Header="应用程序">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,6,0,0">
                        <TextBlock Text="程序 / 库文件（exe / dll / icl / ico / lnk）"
                                   Style="{StaticResource Text.FieldLabel}" Margin="0,0,0,6"/>
                        <DockPanel Margin="0,0,0,14">
                            <Button DockPanel.Dock="Right" Click="AppBrowse_Click" Margin="8,0,0,0" Padding="14,6">
                                <TextBlock Text="浏览…"/>
                            </Button>
                            <TextBox x:Name="AppPathBox"/>
                        </DockPanel>
                        <TextBlock Text="图标切换" Style="{StaticResource Text.FieldLabel}" Margin="0,0,0,6"/>
                        <DockPanel Margin="0,0,0,14">
                            <Button Click="AppIconPrev_Click" Width="32" Height="30" Margin="0,0,8,0">
                                <views:IconView Kind="ChevronLeft" Size="14"/>
                            </Button>
                            <Border Background="{DynamicResource Brush.Tile}" CornerRadius="6"
                                    BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1"
                                    Padding="12,4" Margin="0,0,8,0">
                                <TextBlock x:Name="AppIconIndexText" Text="— / —"
                                           Foreground="{DynamicResource Brush.TextPrimary}" FontSize="12.5"
                                           VerticalAlignment="Center" MinWidth="50"
                                           TextAlignment="Center"/>
                            </Border>
                            <Button Click="AppIconNext_Click" Width="32" Height="30">
                                <views:IconView Kind="ChevronRight" Size="14"/>
                            </Button>
                        </DockPanel>
                        <Border Background="{DynamicResource Brush.Tile}" BorderBrush="{DynamicResource Brush.Stroke}"
                                BorderThickness="1" CornerRadius="10" Padding="12,10">
                            <TextBlock x:Name="AppHint" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" LineHeight="17"
                                       Text="浏览选择程序后自动提取其内嵌图标并缓存；多图标程序可用左右按钮切换。支持 .exe/.dll/.icl/.ico 及开始菜单 .lnk 快捷方式。"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 图片文件 -->
            <TabItem Header="本地图片">
                <StackPanel Margin="0,6,0,0">
                    <TextBlock Text="图片路径（png / ico / jpg / bmp）"
                               Style="{StaticResource Text.FieldLabel}" Margin="0,0,0,6"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Click="ImageBrowse_Click" Margin="8,0,0,0" Padding="14,6">
                            <TextBlock Text="浏览…"/>
                        </Button>
                        <TextBox x:Name="ImagePathBox" TextChanged="ImageInput_Changed"/>
                    </DockPanel>
                    <TextBlock Foreground="{DynamicResource Brush.TextMuted}" FontSize="11" TextWrapping="Wrap"
                               Margin="0,12,0,0" Text="支持绝对路径或由应用程序提取的图标缓存路径。"/>
                </StackPanel>
            </TabItem>

            <!-- 网络图片 -->
            <TabItem Header="网络图片">
                <StackPanel Margin="0,6,0,0">
                    <TextBlock Text="图片地址（URL）" Style="{StaticResource Text.FieldLabel}" Margin="0,0,0,6"/>
                    <TextBox x:Name="UrlBox" TextChanged="UrlInput_Changed"/>
                    <TextBlock Foreground="{DynamicResource Brush.TextMuted}" FontSize="11" TextWrapping="Wrap"
                               Margin="0,12,0,0" Text="生成 [url:图片地址] 语法，面板显示时将自动异步加载并缓存。"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="确定" IsDefault="True" Click="OkButton_Click"
                    Style="{StaticResource DialogPrimaryButton}" Margin="0,0,8,0"/>
            <Button Content="取消" IsCancel="True" Style="{StaticResource DialogGhostButton}"/>
        </StackPanel>
    </Grid>
</Window>