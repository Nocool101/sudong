<Window x:Class="QuickLauncher.App.Views.VariablePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择变量" Width="300" Height="360"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.BgBase}" WindowStyle="None" ResizeMode="NoResize">

    <Border BorderBrush="{StaticResource Brush.Stroke}" BorderThickness="1">
        <DockPanel Margin="14">
            <TextBlock DockPanel.Dock="Top" Text="选择要插入的变量" Foreground="{StaticResource Brush.TextPrimary}" FontSize="13"
                       Margin="0,0,0,10"/>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,10,0,0">
                <Button Content="插入" IsDefault="True" Click="OkButton_Click"
                        Width="70" Height="28" Margin="0,0,8,0"
                        Background="{StaticResource Brush.Gradient}" Foreground="White" BorderThickness="0"/>
                <Button Content="取消" IsCancel="True"
                        Width="70" Height="28" Background="{StaticResource Brush.BgCardHover}" Foreground="{StaticResource Brush.TextSecondary}" BorderThickness="0"/>
            </StackPanel>
            <ListBox x:Name="VarsList" Background="{StaticResource Brush.BgCard}" BorderThickness="0" Foreground="{StaticResource Brush.TextPrimary}"
                     MouseDoubleClick="VarsList_MouseDoubleClick"/>
        </DockPanel>
    </Border>
</Window>
