<Window x:Class="QuickLauncher.App.Views.VariablePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="选择变量" Width="340" Height="400"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent"
        Template="{StaticResource DialogShell}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" GlassFrameThickness="0"
                            CornerRadius="16" ResizeBorderThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Brush.BgCard}"
                BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1" CornerRadius="12" Padding="6">
            <ListBox x:Name="VarsList" Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource Brush.TextPrimary}"
                     MouseDoubleClick="VarsList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="6,4">
                            <Border Background="{DynamicResource Brush.Tile}" CornerRadius="6"
                                    BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1"
                                    Padding="6,2" Margin="0,0,10,0">
                                <TextBlock Text="{}{ }" FontFamily="Consolas, monospace" FontSize="11"
                                           FontWeight="Bold" Foreground="{DynamicResource Brush.Brand}"/>
                            </Border>
                            <TextBlock Text="{Binding}" FontFamily="Consolas, monospace" FontSize="13"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextPrimary}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="插入变量" IsDefault="True" Click="OkButton_Click"
                    Style="{StaticResource DialogPrimaryButton}" Margin="0,0,8,0"/>
            <Button Content="取消" IsCancel="True" Style="{StaticResource DialogGhostButton}"/>
        </StackPanel>
    </Grid>
</Window>