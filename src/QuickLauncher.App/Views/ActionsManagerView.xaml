<UserControl x:Class="QuickLauncher.App.Views.ActionsManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:QuickLauncher.App.Views"
             Background="{StaticResource Brush.BgBase}">

    <DockPanel Margin="24">
        <!-- 页头 -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="动作管理" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource Brush.TextPrimary}"/>
            <TextBlock Text="创建、编辑与运行动作，组合多个步骤完成复杂操作" FontSize="12"
                       Foreground="{StaticResource Brush.TextMuted}" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- 工具栏 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
            <Button x:Name="NewActionButton" Content="＋ 新建动作" Click="NewActionButton_Click"
                    Style="{StaticResource Btn.Primary}" Margin="0,0,8,0"/>
            <Button x:Name="EditActionButton" Content="编辑" Click="EditActionButton_Click"
                    Margin="0,0,8,0"/>
            <Button x:Name="RunActionButton" Content="▶ 运行" Click="RunActionButton_Click"
                    Margin="0,0,8,0"/>
            <Button x:Name="EditPageButton" Content="编辑面板页" Click="EditPageButton_Click"
                    Margin="0,0,8,0"/>
            <Button x:Name="ExportActionButton" Content="导出" Click="ExportActionButton_Click"
                    Margin="0,0,8,0"/>
            <Button x:Name="ImportActionButton" Content="导入" Click="ImportActionButton_Click"
                    Margin="0,0,8,0"/>
            <Button x:Name="DeleteActionButton" Content="删除" Click="DeleteActionButton_Click"
                    Style="{StaticResource Btn.Danger}"/>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource Brush.TextMuted}" FontSize="12"
                       VerticalAlignment="Center" Margin="16,0,0,0"/>
        </StackPanel>

        <!-- 动作列表（卡片容器） -->
        <Border Background="{StaticResource Brush.BgCard}" BorderBrush="{StaticResource Brush.Stroke}"
                BorderThickness="1" CornerRadius="12">
            <ListBox x:Name="ActionsList" Background="Transparent" BorderThickness="0" Padding="6"
                     HorizontalContentAlignment="Stretch"
                     MouseDoubleClick="ActionsList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="6,7">
                            <views:IconPresenter Icon="{Binding Icon}" Size="30"
                                                VerticalAlignment="Center"/>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="13.5"
                                           Foreground="{StaticResource Brush.TextPrimary}"/>
                                <TextBlock Text="{Binding Description}" FontSize="11.5"
                                           Foreground="{StaticResource Brush.TextMuted}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</UserControl>
