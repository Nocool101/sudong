<UserControl x:Class="QuickLauncher.App.Views.ActionsManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:QuickLauncher.App.Views"
             Background="Transparent">

    <DockPanel Margin="28,24,28,24">
        <!-- ═════════ 页头 ═════════ -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="动作管理" Style="{StaticResource Text.PageTitle}"/>
                <TextBlock Text="创建、编辑与运行动作，组合多个步骤完成复杂自动化"
                           Style="{StaticResource Text.PageSubtitle}" Margin="0,5,0,0"/>
            </StackPanel>
            <Button x:Name="NewActionButton" Click="NewActionButton_Click" Grid.Column="1"
                    Style="{StaticResource Btn.Primary}" VerticalAlignment="Top" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <views:IconView Kind="Plus" Size="15"/>
                    <TextBlock Text="新建动作" Margin="7,0,0,0"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ═════════ 工具栏 ═════════ -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <!-- 搜索框 -->
            <Border DockPanel.Dock="Left" Width="200" CornerRadius="10" Background="{DynamicResource Brush.BgCard}"
                    BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1" Margin="0,0,12,0">
                <Grid>
                    <views:IconView Kind="Search" Size="13" Margin="10,0,0,0" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}"/>
                    <TextBox x:Name="SearchBox" Tag="过滤动作…" FontSize="12.5" Padding="30,6,8,6"
                             Background="Transparent" BorderThickness="0"
                             TextChanged="SearchBox_TextChanged"/>
                </Grid>
            </Border>

            <!-- 操作按钮组 -->
            <StackPanel Orientation="Horizontal">
                <Button x:Name="EditActionButton" Click="EditActionButton_Click" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <views:IconView Kind="Pencil" Size="14"/>
                        <TextBlock Text="编辑" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="RunActionButton" Click="RunActionButton_Click" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <views:IconView Kind="Play" Size="14"/>
                        <TextBlock Text="运行" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="EditPageButton" Click="EditPageButton_Click" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <views:IconView Kind="Grid" Size="14"/>
                        <TextBlock Text="编辑面板页" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
                <Border Width="1" Height="18" Background="{DynamicResource Brush.Stroke}" Margin="4,0,10,0"/>
                <Button x:Name="ExportActionButton" Click="ExportActionButton_Click" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <views:IconView Kind="Export" Size="14"/>
                        <TextBlock Text="导出" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ImportActionButton" Click="ImportActionButton_Click" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <views:IconView Kind="Import" Size="14"/>
                        <TextBlock Text="导入" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="DeleteActionButton" Click="DeleteActionButton_Click" Style="{StaticResource Btn.Danger}">
                    <StackPanel Orientation="Horizontal">
                        <views:IconView Kind="Trash" Size="14"/>
                        <TextBlock Text="删除" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- ═════════ 动作列表（卡片） ═════════ -->
        <Border Background="{DynamicResource Brush.BgCard}" BorderBrush="{DynamicResource Brush.Stroke}"
                BorderThickness="1" CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.08" Color="#000000"/>
            </Border.Effect>
            <ListBox x:Name="ActionsList" Background="Transparent" BorderThickness="0" Padding="8"
                     HorizontalContentAlignment="Stretch"
                     MouseDoubleClick="ActionsList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="10,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 图标卡片 -->
                            <Border Width="42" Height="42" CornerRadius="12"
                                    Background="{DynamicResource Brush.Tile}"
                                    BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1">
                                <Grid ClipToBounds="True">
                                    <Border Background="{DynamicResource Brush.Specular}" CornerRadius="12,12,0,0" Height="10" VerticalAlignment="Top"/>
                                    <views:IconPresenter Icon="{Binding Icon}" Size="24"
                                                         VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- 文本信息 -->
                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.TextPrimary}"/>
                                    <!-- 动作类型标签 -->
                                    <Border Background="{DynamicResource Brush.Tile}" CornerRadius="5"
                                            Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center"
                                            BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1">
                                        <TextBlock Text="{Binding SimpleType, FallbackValue='Composite'}"
                                                   FontSize="10.5" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" FontSize="12"
                                           Foreground="{DynamicResource Brush.TextMuted}" Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- 快捷键徽章 -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource Kbd}" Margin="0,0,8,0"
                                        Visibility="{Binding Hotkey, Converter={x:Null}}">
                                    <TextBlock Text="{Binding Hotkey}" Style="{StaticResource KbdText}"/>
                                </Border>
                                <views:IconView Kind="ChevronRight" Size="13" Foreground="{DynamicResource Brush.TextMuted}" Opacity="0.6"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</UserControl>
