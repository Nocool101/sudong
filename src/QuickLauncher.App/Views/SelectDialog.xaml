<Window x:Class="QuickLauncher.App.Views.SelectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="选择" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent"
        Template="{StaticResource DialogShell}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" GlassFrameThickness="0"
                            CornerRadius="16" ResizeBorderThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <StackPanel>
        <TextBlock x:Name="PromptText" FontSize="14" FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.TextPrimary}"
                   Margin="0,0,0,12" TextWrapping="Wrap"/>
        <Border Background="{DynamicResource Brush.BgCard}" BorderBrush="{DynamicResource Brush.Stroke}"
                BorderThickness="1" CornerRadius="12" Padding="6">
            <ListBox x:Name="OptionsList" MaxHeight="280" Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource Brush.TextPrimary}"
                     MouseDoubleClick="OptionsList_MouseDoubleClick"/>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="确定" IsDefault="True" Click="OkButton_Click"
                    Style="{StaticResource DialogPrimaryButton}" Margin="0,0,8,0"/>
            <Button Content="取消" IsCancel="True" Style="{StaticResource DialogGhostButton}"/>
        </StackPanel>
    </StackPanel>
</Window>