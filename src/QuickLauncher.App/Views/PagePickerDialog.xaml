<Window x:Class="QuickLauncher.App.Views.PagePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:QuickLauncher.App.Views"
        Title="选择动作页" Width="400" Height="460"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent"
        Template="{StaticResource DialogShell}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" GlassFrameThickness="0"
                            CornerRadius="16" ResizeBorderThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 搜索 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBox x:Name="SearchBox" Tag="搜索动作页…" FontSize="13" Padding="34,8,12,8"
                     TextChanged="SearchBox_TextChanged"/>
            <views:IconView Kind="Search" Size="14" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="12,0,0,0" Foreground="{DynamicResource Brush.Brand}"/>
        </Grid>

        <!-- 列表 -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.BgCard}"
                BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1" CornerRadius="12" Padding="6">
            <ListBox x:Name="PagesList" Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource Brush.TextPrimary}"
                     MouseDoubleClick="PagesList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="6,4">
                            <Border Width="34" Height="34" CornerRadius="9"
                                    Background="{DynamicResource Brush.Tile}"
                                    BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <views:IconView Kind="Page" Size="16" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Foreground="{DynamicResource Brush.Brand}"/>
                            </Border>
                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextPrimary}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="确定" IsDefault="True" Click="OkButton_Click"
                    Style="{StaticResource DialogPrimaryButton}" Margin="0,0,8,0"/>
            <Button Content="取消" IsCancel="True" Style="{StaticResource DialogGhostButton}"/>
        </StackPanel>
    </Grid>
</Window>