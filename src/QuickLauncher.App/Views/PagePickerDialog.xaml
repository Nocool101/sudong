<Window x:Class="QuickLauncher.App.Views.PagePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择动作页" Width="360" Height="400"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="{StaticResource Brush.BgBase}" WindowStyle="None" ResizeMode="NoResize">

    <Border BorderBrush="{StaticResource Brush.Stroke}" BorderThickness="1">
        <DockPanel Margin="14">
            <TextBlock DockPanel.Dock="Top" Text="选择要加载的动作页" Foreground="{StaticResource Brush.TextPrimary}" FontSize="14"
                       Margin="0,0,0,10"/>
            <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Background="{StaticResource Brush.BgCardHover}" Foreground="{StaticResource Brush.TextPrimary}"
                     BorderThickness="0" Padding="8,7" Margin="0,0,0,10"
                     TextChanged="SearchBox_TextChanged"/>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,10,0,0">
                <Button Content="确定" IsDefault="True" Click="OkButton_Click"
                        Width="80" Height="28" Margin="0,0,8,0"
                        Background="{StaticResource Brush.Gradient}" Foreground="White" BorderThickness="0"/>
                <Button Content="取消" IsCancel="True"
                        Width="80" Height="28" Background="{StaticResource Brush.BgCardHover}" Foreground="{StaticResource Brush.TextSecondary}" BorderThickness="0"/>
            </StackPanel>
            <ListBox x:Name="PagesList" Background="{StaticResource Brush.BgCard}" BorderThickness="0" Foreground="{StaticResource Brush.TextPrimary}"
                     MouseDoubleClick="PagesList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="4,5">
                            <TextBlock Text="📑" FontSize="15" VerticalAlignment="Center"/>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource Brush.TextPrimary}"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</Window>
