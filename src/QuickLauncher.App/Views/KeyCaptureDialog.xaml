<Window x:Class="QuickLauncher.App.Views.KeyCaptureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="请按下按键" Width="320" Height="180"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.BgBase}" WindowStyle="None" ResizeMode="NoResize">

    <Border BorderBrush="{StaticResource Brush.Brand}" BorderThickness="1.5">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="请按下要捕获的按键组合" Foreground="{StaticResource Brush.TextSecondary}" FontSize="13"
                       HorizontalAlignment="Center" Margin="0,0,0,16"/>
            <Border x:Name="KeyBox" Width="220" Height="56" Background="{StaticResource Brush.BgCard}"
                    CornerRadius="6" BorderBrush="{StaticResource Brush.Stroke}" BorderThickness="1">
                <TextBlock x:Name="KeyText" Text="等待按键..." Foreground="{StaticResource Brush.TextPrimary}" FontSize="18"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="按下组合键即录制 · Enter 确认 · Esc 取消" Foreground="{StaticResource Brush.TextMuted}"
                       FontSize="11" HorizontalAlignment="Center" Margin="0,14,0,0"/>
        </StackPanel>
    </Border>
</Window>
