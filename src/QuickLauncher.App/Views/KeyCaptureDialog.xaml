<Window x:Class="QuickLauncher.App.Views.KeyCaptureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:QuickLauncher.App.Views"
        Title="捕获按键" Width="360" Height="250"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent"
        Template="{StaticResource DialogShell}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" GlassFrameThickness="0"
                            CornerRadius="16" ResizeBorderThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <StackPanel Margin="6,4,6,0">
        <TextBlock Text="请直接在键盘上按下要录制的按键组合"
                   Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12.5"
                   HorizontalAlignment="Center" Margin="0,0,0,16"/>

        <!-- 键盘按键展示区 -->
        <Border x:Name="KeyBox" Height="74" Background="{DynamicResource Brush.BgCard}"
                CornerRadius="14" BorderBrush="{DynamicResource Brush.Brand}" BorderThickness="1.5">
            <Border.Effect>
                <DropShadowEffect Color="#6366F1" Opacity="0.25" BlurRadius="16" ShadowDepth="0"/>
            </Border.Effect>
            <Grid>
                <Border Background="{DynamicResource Brush.GradientSoft}" Opacity="0.5" CornerRadius="12.5"/>
                <TextBlock x:Name="KeyText" Text="等待按键输入…" Foreground="{DynamicResource Brush.TextPrimary}"
                           FontSize="20" FontWeight="Bold" FontFamily="Consolas, 'Segoe UI Variable Display', sans-serif"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 底部快捷键提示 -->
        <Border Background="{DynamicResource Brush.Tile}" CornerRadius="9"
                BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1"
                Padding="12,8" Margin="0,16,0,0" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource Kbd}" Margin="0,0,6,0">
                    <TextBlock Style="{StaticResource KbdText}" Text="按下按键"/>
                </Border>
                <TextBlock Text="即刻录制 · " Foreground="{DynamicResource Brush.TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                <Border Style="{StaticResource Kbd}" Margin="0,0,6,0">
                    <TextBlock Style="{StaticResource KbdText}" Text="ESC"/>
                </Border>
                <TextBlock Text="取消" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>