<Window x:Class="QuickLauncher.App.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.BgCard}" WindowStyle="None" ResizeMode="NoResize">

    <Border BorderBrush="{StaticResource Brush.Stroke}" BorderThickness="1">
        <StackPanel Margin="20">
            <TextBlock x:Name="PromptText" Foreground="{StaticResource Brush.TextPrimary}" FontSize="14" Margin="0,0,0,10"
                       TextWrapping="Wrap"/>
            <TextBox x:Name="InputBox" MinHeight="28" Background="{StaticResource Brush.BgCardHover}" Foreground="White"
                     BorderThickness="0" Padding="8,6" FontSize="13"
                     AcceptsReturn="False"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="确定" IsDefault="True" Click="OkButton_Click"
                        Width="80" Height="30" Margin="0,0,8,0"
                        Background="{StaticResource Brush.Gradient}" Foreground="White" BorderThickness="0"/>
                <Button Content="取消" IsCancel="True"
                        Width="80" Height="30" Background="{StaticResource Brush.BgCardHover}" Foreground="{StaticResource Brush.TextSecondary}" BorderThickness="0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
