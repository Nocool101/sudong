<Window x:Class="QuickLauncher.App.Views.PageEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="动作页编辑器" Width="720" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.BgBase}">

    <Window.Resources>
        <Style x:Key="CellButton" TargetType="Button">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Brush.Brand}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <!-- 底部按钮 -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="保存" IsDefault="True" Click="SaveButton_Click"
                    Width="90" Height="32" Margin="0,0,8,0"
                    Background="{StaticResource Brush.Gradient}" Foreground="White" BorderThickness="0"/>
            <Button Content="取消" IsCancel="True"
                    Width="90" Height="32" Background="{StaticResource Brush.BgCardHover}" Foreground="{StaticResource Brush.TextSecondary}" BorderThickness="0"/>
        </StackPanel>

        <!-- 顶部工具栏 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="页名" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="NameBox" Width="160" Background="{StaticResource Brush.BgCardHover}" Foreground="{StaticResource Brush.TextPrimary}"
                     BorderThickness="0" Padding="8,6"/>
            <TextBlock Text="列数" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="16,0,8,0"/>
            <TextBox x:Name="ColumnsBox" Width="50" Background="{StaticResource Brush.BgCardHover}" Foreground="{StaticResource Brush.TextPrimary}"
                     BorderThickness="0" Padding="8,6" TextChanged="LayoutBox_TextChanged"/>
            <TextBlock Text="行数" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="16,0,8,0"/>
            <TextBox x:Name="RowsBox" Width="50" Background="{StaticResource Brush.BgCardHover}" Foreground="{StaticResource Brush.TextPrimary}"
                     BorderThickness="0" Padding="8,6" TextChanged="LayoutBox_TextChanged"/>
            <Button Content="清空全部" Click="ClearAllButton_Click" HorizontalAlignment="Right"
                    Margin="24,0,0,0" Padding="12,5" Background="{StaticResource Brush.BgCardHover}" Foreground="{StaticResource Brush.Danger}"
                    BorderThickness="0" Cursor="Hand"/>
        </StackPanel>

        <!-- 提示 -->
        <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource Brush.TextMuted}" FontSize="11" Margin="0,0,0,8"
                   Text="点击格子选择动作；右键点击清除。格子从左到右、从上到下排列。"/>

        <!-- 网格 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <UniformGrid x:Name="CellsGrid" MouseRightButtonUp="CellsGrid_MouseRightButtonUp"/>
        </ScrollViewer>
    </DockPanel>
</Window>
