<Window x:Class="QuickLauncher.App.Views.AddActionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:QuickLauncher.App.Views"
        Title="添加动作" Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent"
        Template="{StaticResource DialogShell}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" GlassFrameThickness="0"
                            CornerRadius="16" ResizeBorderThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 菜单列表项：矢量图标容器 + 文字，hover 渐变高亮 -->
        <Style x:Key="MenuItemBtn" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent" CornerRadius="10" Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.HoverOverlay}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.PressOverlay}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 顶部主入口按钮：基础 / 组合动作 -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
            <Setter Property="Height" Value="62"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <Grid ClipToBounds="True">
                                <Border Background="{DynamicResource Brush.Specular}" CornerRadius="12,12,0,0" Height="14" VerticalAlignment="Top"/>
                                <Border x:Name="ov" Background="Transparent" CornerRadius="12"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ov" Property="Background" Value="{DynamicResource Brush.HoverOverlay}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ov" Property="Background" Value="{DynamicResource Brush.PressOverlay}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500">
        <StackPanel Margin="0,4,0,0">
            <!-- 两个主入口 -->
            <UniformGrid Columns="2" Margin="0,0,0,14">
                <Button CommandParameter="NewBasic" Click="Item_Click" Style="{StaticResource PrimaryBtn}"
                        Margin="0,0,5,0">
                    <StackPanel HorizontalAlignment="Center">
                        <views:IconView Kind="Plus" Size="18"/>
                        <TextBlock Text="新建基础动作" FontSize="12.5" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
                <Button CommandParameter="NewComposite" Click="Item_Click" Style="{StaticResource PrimaryBtn}"
                        Margin="5,0,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <views:IconView Kind="Bolt" Size="18"/>
                        <TextBlock Text="新建组合动作" FontSize="12.5" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <TextBlock Text="预设动作类型" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.TextMuted}" Margin="4,0,0,6"/>

            <!-- 动作类型列表 -->
            <Button CommandParameter="NewRunProgram" Click="Item_Click" Style="{StaticResource MenuItemBtn}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource Brush.Tile}"
                            BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1">
                        <views:IconView Kind="Monitor" Size="14" Foreground="{DynamicResource Brush.Brand}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="启动软件" FontSize="13" Margin="11,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button CommandParameter="NewOpenFile" Click="Item_Click" Style="{StaticResource MenuItemBtn}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource Brush.Tile}"
                            BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1">
                        <views:IconView Kind="File" Size="14" Foreground="{DynamicResource Brush.Brand}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="打开文件" FontSize="13" Margin="11,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button CommandParameter="NewOpenFolder" Click="Item_Click" Style="{StaticResource MenuItemBtn}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource Brush.Tile}"
                            BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1">
                        <views:IconView Kind="Folder" Size="14" Foreground="{DynamicResource Brush.Brand}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="打开文件夹" FontSize="13" Margin="11,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button CommandParameter="NewRunCommand" Click="Item_Click" Style="{StaticResource MenuItemBtn}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource Brush.Tile}"
                            BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1">
                        <views:IconView Kind="Terminal" Size="14" Foreground="{DynamicResource Brush.Brand}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="运行命令" FontSize="13" Margin="11,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button CommandParameter="NewOpenUrl" Click="Item_Click" Style="{StaticResource MenuItemBtn}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource Brush.Tile}"
                            BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1">
                        <views:IconView Kind="Globe" Size="14" Foreground="{DynamicResource Brush.Brand}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="打开网址" FontSize="13" Margin="11,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button CommandParameter="NewSendKeys" Click="Item_Click" Style="{StaticResource MenuItemBtn}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource Brush.Tile}"
                            BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1">
                        <views:IconView Kind="Keyboard" Size="14" Foreground="{DynamicResource Brush.Brand}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="模拟按键" FontSize="13" Margin="11,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button CommandParameter="NewSendText" Click="Item_Click" Style="{StaticResource MenuItemBtn}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource Brush.Tile}"
                            BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1">
                        <views:IconView Kind="Message" Size="14" Foreground="{DynamicResource Brush.Brand}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="发送文本" FontSize="13" Margin="11,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button CommandParameter="NewScript" Click="Item_Click" Style="{StaticResource MenuItemBtn}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource Brush.Tile}"
                            BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1">
                        <views:IconView Kind="Scroll" Size="14" Foreground="{DynamicResource Brush.Brand}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="执行脚本" FontSize="13" Margin="11,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button CommandParameter="NewSwitchPage" Click="Item_Click" Style="{StaticResource MenuItemBtn}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource Brush.Tile}"
                            BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1">
                        <views:IconView Kind="Page" Size="14" Foreground="{DynamicResource Brush.Brand}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="加载动作页" FontSize="13" Margin="11,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Border Height="1" Background="{DynamicResource Brush.Stroke}" Margin="4,8,4,8"/>

            <Button CommandParameter="ImportAction" Click="Item_Click" Style="{StaticResource MenuItemBtn}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource Brush.Tile}"
                            BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1">
                        <views:IconView Kind="Import" Size="14" Foreground="{DynamicResource Brush.TextSecondary}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="导入动作" FontSize="13" Margin="11,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button CommandParameter="PickExisting" Click="Item_Click" Style="{StaticResource MenuItemBtn}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource Brush.Tile}"
                            BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1">
                        <views:IconView Kind="Copy" Size="14" Foreground="{DynamicResource Brush.TextSecondary}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="从已有动作中选择…" FontSize="13" Margin="11,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Content="取消" Click="CancelButton_Click" HorizontalAlignment="Center"
                    Margin="0,12,0,4" Padding="22,6" Style="{StaticResource Btn.Ghost}"/>
        </StackPanel>
    </ScrollViewer>
</Window>
