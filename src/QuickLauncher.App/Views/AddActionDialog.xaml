<Window x:Class="QuickLauncher.App.Views.AddActionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加动作" Width="288" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="Transparent" WindowStyle="None" ResizeMode="NoResize">

    <Window.Resources>
        <!-- 菜单列表项：图标 + 文字，hover 淡渐变高亮 -->
        <Style x:Key="MenuItemBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent" CornerRadius="8" Padding="10,0">
                            <DockPanel>
                                <TextBlock Text="{TemplateBinding Tag}" FontSize="14"
                                           Width="26" VerticalAlignment="Center" TextAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource Brush.GradientSoft}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 顶部主按钮（新建基础/组合动作）：品牌渐变 -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Background" Value="{StaticResource Brush.Gradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <Grid>
                                <Border x:Name="ov" Background="Transparent" CornerRadius="10"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding Tag}" FontSize="17" HorizontalAlignment="Center"/>
                                    <ContentPresenter HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ov" Property="Background" Value="#1FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ov" Property="Background" Value="#2AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 渐变描边 + 深色半透明面板 -->
    <Border CornerRadius="13" Background="{StaticResource Brush.Gradient}" Padding="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.5"/>
        </Border.Effect>
        <Border CornerRadius="12" Background="#F00F1218">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14">

                    <TextBlock Text="添加动作到此位置" Foreground="{StaticResource Brush.TextPrimary}" FontSize="14"
                               FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,14"/>

                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <Button Tag="✚" CommandParameter="NewBasic" Content="新建基础动作" Click="Item_Click"
                                Style="{StaticResource PrimaryBtn}" Margin="0,0,4,0"/>
                        <Button Tag="⚡" CommandParameter="NewComposite" Content="新建组合动作" Click="Item_Click"
                                Style="{StaticResource PrimaryBtn}" Margin="4,0,0,0"/>
                    </UniformGrid>

                    <Border Height="1" Background="#1FFFFFFF" Margin="0,2,0,8"/>

                    <Button Tag="🖥" CommandParameter="NewRunProgram" Content="启动软件" Click="Item_Click" Style="{StaticResource MenuItemBtn}"/>
                    <Button Tag="📄" CommandParameter="NewOpenFile" Content="打开文件" Click="Item_Click" Style="{StaticResource MenuItemBtn}"/>
                    <Button Tag="📁" CommandParameter="NewOpenFolder" Content="打开文件夹" Click="Item_Click" Style="{StaticResource MenuItemBtn}"/>
                    <Button Tag="🚀" CommandParameter="NewRunCommand" Content="运行命令" Click="Item_Click" Style="{StaticResource MenuItemBtn}"/>
                    <Button Tag="🌐" CommandParameter="NewOpenUrl" Content="打开网址" Click="Item_Click" Style="{StaticResource MenuItemBtn}"/>
                    <Button Tag="⌨" CommandParameter="NewSendKeys" Content="模拟按键" Click="Item_Click" Style="{StaticResource MenuItemBtn}"/>
                    <Button Tag="💬" CommandParameter="NewSendText" Content="发送文本" Click="Item_Click" Style="{StaticResource MenuItemBtn}"/>
                    <Button Tag="📜" CommandParameter="NewScript" Content="执行脚本" Click="Item_Click" Style="{StaticResource MenuItemBtn}"/>
                    <Button Tag="📑" CommandParameter="NewSwitchPage" Content="加载动作页" Click="Item_Click" Style="{StaticResource MenuItemBtn}"/>

                    <Border Height="1" Background="#1FFFFFFF" Margin="0,8,0,8"/>

                    <Button Tag="📥" CommandParameter="ImportAction" Content="导入动作" Click="Item_Click" Style="{StaticResource MenuItemBtn}"/>
                    <Button Tag="📋" CommandParameter="PickExisting" Content="从已有动作选择" Click="Item_Click" Style="{StaticResource MenuItemBtn}"/>

                    <Button Content="取消" Click="CancelButton_Click"
                            HorizontalAlignment="Center" Margin="0,10,0,0" Padding="18,5"
                            Style="{StaticResource Btn.Ghost}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Border>
</Window>
