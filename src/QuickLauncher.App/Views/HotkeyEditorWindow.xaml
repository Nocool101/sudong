<Window x:Class="QuickLauncher.App.Views.HotkeyEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="扩展热键编辑器" Width="440" Height="360"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.BgBase}">

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="保存" IsDefault="True" Click="SaveButton_Click"
                    Width="90" Height="32" Margin="0,0,8,0"
                    Background="{StaticResource Brush.Gradient}" Foreground="White" BorderThickness="0"/>
            <Button Content="取消" IsCancel="True"
                    Width="90" Height="32" Background="{StaticResource Brush.BgCardHover}" Foreground="{StaticResource Brush.TextSecondary}" BorderThickness="0"/>
        </StackPanel>

        <StackPanel>
            <TextBlock Text="引导键" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
            <ComboBox x:Name="LeaderCombo" Background="{StaticResource Brush.BgCardHover}" Foreground="White" BorderThickness="0"
                      Padding="8,6" Margin="0,0,0,12">
                <ComboBoxItem Content="CapsLock" IsSelected="True"/>
                <ComboBoxItem Content="Space"/>
                <ComboBoxItem Content="Tab"/>
                <ComboBoxItem Content="` (反引号)"/>
                <ComboBoxItem Content="Enter"/>
                <ComboBoxItem Content="Esc"/>
            </ComboBox>

            <TextBlock Text="动作键（留空 = 单独按引导键触发）" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
            <ComboBox x:Name="ActionCombo" Background="{StaticResource Brush.BgCardHover}" Foreground="White" BorderThickness="0"
                      Padding="8,6" Margin="0,0,0,12"/>

            <TextBlock Text="修饰键（可选）" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
            <ComboBox x:Name="ModifierCombo" Background="{StaticResource Brush.BgCardHover}" Foreground="White" BorderThickness="0"
                      Padding="8,6" Margin="0,0,0,12">
                <ComboBoxItem Content="（无）" IsSelected="True"/>
                <ComboBoxItem Content="Ctrl"/>
                <ComboBoxItem Content="Alt"/>
                <ComboBoxItem Content="Shift"/>
            </ComboBox>

            <TextBlock Text="执行的动作" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
            <ComboBox x:Name="ActionTargetCombo" Background="{StaticResource Brush.BgCardHover}" Foreground="White" BorderThickness="0"
                      Padding="8,6" DisplayMemberPath="Name" SelectedValuePath="Id"/>

            <CheckBox x:Name="EnabledBox" Content="启用" Foreground="{StaticResource Brush.TextPrimary}" Margin="0,12,0,0"/>
        </StackPanel>
    </DockPanel>
</Window>
