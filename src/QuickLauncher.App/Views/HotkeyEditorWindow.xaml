<Window x:Class="QuickLauncher.App.Views.HotkeyEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="扩展热键编辑器" Width="460" Height="410"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent"
        Template="{StaticResource DialogShell}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" GlassFrameThickness="0"
                            CornerRadius="16" ResizeBorderThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Brush.BgCard}"
                BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1"
                CornerRadius="12" Padding="16,14">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock Text="引导键" Style="{StaticResource Text.FieldLabel}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="LeaderCombo">
                            <ComboBoxItem Content="CapsLock" IsSelected="True"/>
                            <ComboBoxItem Content="Space"/>
                            <ComboBoxItem Content="Tab"/>
                            <ComboBoxItem Content="` (反引号)"/>
                            <ComboBoxItem Content="Enter"/>
                            <ComboBoxItem Content="Esc"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="动作键（可选）" Style="{StaticResource Text.FieldLabel}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="ActionCombo"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="修饰键（可选）" Style="{StaticResource Text.FieldLabel}" Margin="0,0,0,5"/>
                <ComboBox x:Name="ModifierCombo" Margin="0,0,0,12">
                    <ComboBoxItem Content="（无）" IsSelected="True"/>
                    <ComboBoxItem Content="Ctrl"/>
                    <ComboBoxItem Content="Alt"/>
                    <ComboBoxItem Content="Shift"/>
                </ComboBox>

                <TextBlock Text="执行的目标动作" Style="{StaticResource Text.FieldLabel}" Margin="0,0,0,5"/>
                <ComboBox x:Name="ActionTargetCombo" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,14"/>

                <CheckBox x:Name="EnabledBox" Content="启用此热键触发"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="保存" IsDefault="True" Click="SaveButton_Click"
                    Style="{StaticResource DialogPrimaryButton}" Margin="0,0,8,0"/>
            <Button Content="取消" IsCancel="True" Style="{StaticResource DialogGhostButton}"/>
        </StackPanel>
    </Grid>
</Window>