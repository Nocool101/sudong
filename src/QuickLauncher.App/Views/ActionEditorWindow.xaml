<Window x:Class="QuickLauncher.App.Views.ActionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:QuickLauncher.App.Views"
        Title="动作编辑器" Width="980" Height="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.BgBase}">

    <DockPanel Margin="16">
        <!-- 底部按钮 -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="保存" IsDefault="True" Click="SaveButton_Click"
                    Width="90" Height="32" Margin="0,0,8,0"
                    Background="{StaticResource Brush.Gradient}" Foreground="White" BorderThickness="0"/>
            <Button Content="取消" IsCancel="True"
                    Width="90" Height="32" Background="{StaticResource Brush.BgCardHover}" Foreground="{StaticResource Brush.TextSecondary}" BorderThickness="0"/>
        </StackPanel>

        <!-- 顶部基本信息 -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <DockPanel Margin="0,0,0,8">
                <TextBlock Text="名称" Foreground="{StaticResource Brush.TextSecondary}" Width="60" VerticalAlignment="Center"/>
                <TextBox x:Name="NameBox" Background="{StaticResource Brush.BgCardHover}" Foreground="{StaticResource Brush.TextPrimary}" BorderThickness="0"
                         Padding="8,6"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,8">
                <TextBlock Text="图标" Foreground="{StaticResource Brush.TextSecondary}" Width="60" VerticalAlignment="Center"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="IconBox" Background="{StaticResource Brush.BgCardHover}" Foreground="{StaticResource Brush.TextPrimary}" BorderThickness="0"
                             Padding="8,6" TextChanged="IconBox_TextChanged"
                             ToolTip="支持：[fa:图标名:颜色]、[url:图片地址]、图片路径、单个字符；也可提取程序图标"/>
                    <Button Grid.Column="1" Content="选择..." Click="PickIconButton_Click"
                            Margin="6,0,0,0" Padding="12,4" Background="{StaticResource Brush.BgCardHover}" Foreground="{StaticResource Brush.TextSecondary}"
                            BorderThickness="0" Cursor="Hand"/>
                    <Button Grid.Column="2" x:Name="ExtractIconButton" Content="提取程序图标" Click="ExtractIconButton_Click"
                            Margin="6,0,0,0" Padding="12,4" Background="{StaticResource Brush.BgCardHover}" Foreground="{StaticResource Brush.TextSecondary}"
                            BorderThickness="0" Cursor="Hand" ToolTip="从当前配置的程序路径提取内嵌图标"/>
                    <Border Grid.Column="3" x:Name="IconPreviewBorder" Width="30" Height="30" Margin="6,0,0,0"
                            CornerRadius="4" Background="#33FFFFFF">
                        <Grid>
                            <TextBlock x:Name="IconPreviewText" Text="▶" FontSize="16" Foreground="{StaticResource Brush.Brand}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="IconPreviewImage" Width="22" Height="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </Grid>
            </DockPanel>
            <DockPanel Margin="0,0,0,8">
                <TextBlock Text="描述" Foreground="{StaticResource Brush.TextSecondary}" Width="60" VerticalAlignment="Center"/>
                <TextBox x:Name="DescBox" Background="{StaticResource Brush.BgCardHover}" Foreground="{StaticResource Brush.TextPrimary}" BorderThickness="0"
                         Padding="8,6"/>
            </DockPanel>
            <DockPanel>
                <TextBlock Text="快捷键" Foreground="{StaticResource Brush.TextSecondary}" Width="60" VerticalAlignment="Center"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="HotkeyBox" Background="{StaticResource Brush.BgCardHover}" Foreground="{StaticResource Brush.TextPrimary}"
                             BorderThickness="0" Padding="8,6"
                             ToolTip="全局快捷键，如 Ctrl+Alt+P。留空则不绑定。"/>
                    <Button Grid.Column="1" Content="录制" Click="RecordHotkeyButton_Click"
                            Margin="6,0,0,0" Padding="12,4" Background="{StaticResource Brush.BgCardHover}" Foreground="{StaticResource Brush.TextSecondary}"
                            BorderThickness="0" Cursor="Hand"/>
                </Grid>
            </DockPanel>
        </StackPanel>

        <!-- 类型切换 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton x:Name="SimpleRadio" Content="简单动作" Foreground="{StaticResource Brush.TextPrimary}"
                         Checked="TypeRadio_Checked" Margin="0,0,16,0"/>
            <RadioButton x:Name="CompositeRadio" Content="组合动作" Foreground="{StaticResource Brush.TextPrimary}"
                         Checked="TypeRadio_Checked"/>
        </StackPanel>

        <!-- 简单动作编辑区（限高：参数表单在 StepParamEditor 内部滚动，保证底部按钮不被挤出窗口） -->
        <StackPanel x:Name="SimpleEditor" DockPanel.Dock="Top" Margin="0,0,0,12" MaxHeight="430">
            <DockPanel Margin="0,0,0,8">
                <TextBlock Text="类型" Foreground="{StaticResource Brush.TextSecondary}" Width="60" VerticalAlignment="Center"/>
                <ComboBox x:Name="SimpleTypeCombo" Width="260" HorizontalAlignment="Left"
                          SelectionChanged="SimpleTypeCombo_SelectionChanged">
                    <ComboBoxItem Content="打开网址 (OpenUrl)"/>
                    <ComboBoxItem Content="打开文件 (OpenFile)"/>
                    <ComboBoxItem Content="打开文件夹 (OpenFolder)"/>
                    <ComboBoxItem Content="运行程序 (RunProgram)"/>
                    <ComboBoxItem Content="发送文本 (SendText)"/>
                    <ComboBoxItem Content="模拟按键 (SendKeys)"/>
                    <ComboBoxItem Content="加载动作页 (SwitchPage)"/>
                    <ComboBoxItem Content="运行命令 (RunCommand)"/>
                    <ComboBoxItem Content="执行脚本 (RunScript)"/>
                </ComboBox>
            </DockPanel>
            <!-- 参数表单：按所选类型渲染专属参数（复用步骤参数编辑器，支持下拉/多行/布尔/浏览/按键捕获/变量） -->
            <views:StepParamEditor x:Name="SimpleParamEditor"/>
        </StackPanel>

        <!-- 组合动作编辑区：左右分栏 -->
        <DockPanel x:Name="CompositeEditor">
            <!-- 步骤工具栏 -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="＋ 添加步骤" Click="AddStepButton_Click"
                        Background="{StaticResource Brush.Gradient}" Foreground="White" BorderThickness="0"
                        Padding="12,5" Margin="0,0,8,0" Cursor="Hand"/>
                <Button Content="＋ 如果" Click="AddIfButton_Click"
                        Background="{StaticResource Brush.BgCardHover}" Foreground="{StaticResource Brush.TextSecondary}" BorderThickness="0"
                        Padding="12,5" Margin="0,0,8,0" Cursor="Hand"/>
                <Button Content="＋ 循环" Click="AddRepeatButton_Click"
                        Background="{StaticResource Brush.BgCardHover}" Foreground="{StaticResource Brush.TextSecondary}" BorderThickness="0"
                        Padding="12,5" Margin="0,0,8,0" Cursor="Hand"/>
                <Button Content="↑" Click="MoveUpButton_Click" ToolTip="上移"
                        Background="{StaticResource Brush.BgCardHover}" Foreground="{StaticResource Brush.TextSecondary}" BorderThickness="0"
                        Padding="10,5" Margin="0,0,4,0" Cursor="Hand"/>
                <Button Content="↓" Click="MoveDownButton_Click" ToolTip="下移"
                        Background="{StaticResource Brush.BgCardHover}" Foreground="{StaticResource Brush.TextSecondary}" BorderThickness="0"
                        Padding="10,5" Margin="0,0,8,0" Cursor="Hand"/>
                <Button Content="删除" Click="DeleteStepButton_Click"
                        Background="{StaticResource Brush.BgCardHover}" Foreground="{StaticResource Brush.Danger}" BorderThickness="0"
                        Padding="12,5" Cursor="Hand"/>
            </StackPanel>

            <!-- 左：步骤列表 -->
            <ListBox x:Name="StepsList" Width="300" Margin="0,0,10,0"
                     Background="{StaticResource Brush.BgCard}" BorderThickness="0"
                     SelectionChanged="StepsList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,5">
                            <TextBlock Text="{Binding DisplayName}" FontSize="13" Foreground="{StaticResource Brush.TextPrimary}"/>
                            <TextBlock Text="{Binding Summary}" FontSize="10" Foreground="{StaticResource Brush.TextMuted}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 右：参数编辑器 -->
            <Border Background="{StaticResource Brush.BgCard}" CornerRadius="6">
                <views:StepParamEditor x:Name="ParamEditor"/>
            </Border>
        </DockPanel>
    </DockPanel>
</Window>
