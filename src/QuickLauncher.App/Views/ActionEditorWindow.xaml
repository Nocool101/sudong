<Window x:Class="QuickLauncher.App.Views.ActionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:QuickLauncher.App.Views"
        Title="动作编辑器" Width="1000" Height="700"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent"
        Template="{StaticResource DialogShell}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" GlassFrameThickness="0"
                            CornerRadius="16" ResizeBorderThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═════════ 顶部基本信息卡片 ═════════ -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.BgCard}"
                BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1"
                CornerRadius="14" Padding="18,14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左列：名称与图标 -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="动作名称" Style="{StaticResource Text.FieldLabel}" Margin="0,0,0,5"/>
                    <TextBox x:Name="NameBox" Margin="0,0,0,12"/>

                    <TextBlock Text="图标" Style="{StaticResource Text.FieldLabel}" Margin="0,0,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="IconBox" Margin="0,0,0,0"
                                 TextChanged="IconBox_TextChanged"
                                 ToolTip="支持：[fa:图标名:颜色]、[url:图片地址]、图片路径、单个字符；也可提取程序图标"/>
                        <Button Grid.Column="1" Click="PickIconButton_Click" Margin="6,0,0,0"
                                Padding="12,6">
                            <TextBlock Text="选择…"/>
                        </Button>
                        <Button Grid.Column="2" x:Name="ExtractIconButton" Click="ExtractIconButton_Click"
                                Margin="6,0,0,0" Padding="12,6"
                                ToolTip="从当前配置的程序路径提取内嵌图标">
                            <TextBlock Text="提取程序图标"/>
                        </Button>
                        <Border Grid.Column="3" x:Name="IconPreviewBorder" Width="36" Height="36" Margin="8,0,0,0"
                                CornerRadius="10" Background="{DynamicResource Brush.Tile}"
                                BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1">
                            <Grid ClipToBounds="True">
                                <Border Background="{DynamicResource Brush.Specular}" CornerRadius="10,10,0,0" Height="8" VerticalAlignment="Top"/>
                                <TextBlock x:Name="IconPreviewText" Text="▶" FontSize="18"
                                           Foreground="{DynamicResource Brush.Brand}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="IconPreviewImage" Width="24" Height="24"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- 右列：描述与快捷键 -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="动作描述" Style="{StaticResource Text.FieldLabel}" Margin="0,0,0,5"/>
                    <TextBox x:Name="DescBox" Margin="0,0,0,12"/>

                    <TextBlock Text="全局快捷键" Style="{StaticResource Text.FieldLabel}" Margin="0,0,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HotkeyBox" ToolTip="全局快捷键，如 Ctrl+Alt+P。留空则不绑定。"/>
                        <Button Grid.Column="1" Click="RecordHotkeyButton_Click" Margin="8,0,0,0"
                                Padding="14,6">
                            <StackPanel Orientation="Horizontal">
                                <views:IconView Kind="Record" Size="14"/>
                                <TextBlock Text="录制" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═════════ 类型切换 ═════════ -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,0,0,12">
            <RadioButton x:Name="SimpleRadio" Content="简单动作" Checked="TypeRadio_Checked" Margin="0,0,24,0"/>
            <RadioButton x:Name="CompositeRadio" Content="组合动作" Checked="TypeRadio_Checked"/>
        </StackPanel>

        <!-- ═════════ 编辑区 ═════════ -->
        <Grid Grid.Row="2">
            <!-- 简单动作编辑区 -->
            <StackPanel x:Name="SimpleEditor" Margin="0,0,0,0" MaxHeight="430">
                <TextBlock Text="动作类型" Style="{StaticResource Text.FieldLabel}" Margin="0,0,0,6"/>
                <ComboBox x:Name="SimpleTypeCombo" Width="300" HorizontalAlignment="Left"
                          Margin="0,0,0,14"
                          SelectionChanged="SimpleTypeCombo_SelectionChanged">
                    <ComboBoxItem Content="打开网址 (OpenUrl)"/>
                    <ComboBoxItem Content="打开文件 (OpenFile)"/>
                    <ComboBoxItem Content="打开文件夹 (OpenFolder)"/>
                    <ComboBoxItem Content="运行程序 (RunProgram)"/>
                    <ComboBoxItem Content="发送文本 (SendText)"/>
                    <ComboBoxItem Content="模拟按键 (SendKeys)"/>
                    <ComboBoxItem Content="加载动作页 (SwitchPage)"/>
                    <ComboBoxItem Content="运行命令 (RunCommand)"/>
                    <ComboBoxItem Content="执行脚本 (RunScript)"/>
                </ComboBox>
                <views:StepParamEditor x:Name="SimpleParamEditor"/>
            </StackPanel>

            <!-- 组合动作编辑区：左右分栏 -->
            <Grid x:Name="CompositeEditor">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左：步骤列表 + 工具栏 -->
                <DockPanel Grid.Column="0" Margin="0,0,14,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Click="AddStepButton_Click" Style="{StaticResource Btn.Primary}"
                                Padding="13,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <views:IconView Kind="Plus" Size="14"/>
                                <TextBlock Text="添加步骤" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Click="AddIfButton_Click" Padding="12,6" Margin="0,0,6,0">
                            <TextBlock Text="如果"/>
                        </Button>
                        <Button Click="AddRepeatButton_Click" Padding="12,6" Margin="0,0,6,0">
                            <TextBlock Text="循环"/>
                        </Button>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Click="MoveUpButton_Click" ToolTip="上移" Padding="10,6" Margin="0,0,6,0">
                            <views:IconView Kind="ArrowUp" Size="14"/>
                        </Button>
                        <Button Click="MoveDownButton_Click" ToolTip="下移" Padding="10,6" Margin="0,0,6,0">
                            <views:IconView Kind="ArrowDown" Size="14"/>
                        </Button>
                        <Button Click="DeleteStepButton_Click" Style="{StaticResource Btn.Danger}" Padding="11,6">
                            <StackPanel Orientation="Horizontal">
                                <views:IconView Kind="Trash" Size="14"/>
                                <TextBlock Text="删除" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Border Background="{DynamicResource Brush.BgCard}"
                            BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1"
                            CornerRadius="12" Padding="6">
                        <ListBox x:Name="StepsList" Background="Transparent" BorderThickness="0"
                                 SelectionChanged="StepsList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="6,5">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"/>
                                        <TextBlock Text="{Binding Summary}" FontSize="11"
                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>

                <!-- 右：参数编辑器 -->
                <Border Grid.Column="1" Background="{DynamicResource Brush.BgCard}"
                        BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1"
                        CornerRadius="12" Padding="4">
                    <views:StepParamEditor x:Name="ParamEditor"/>
                </Border>
            </Grid>
        </Grid>

        <!-- ═════════ 底部按钮 ═════════ -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="保存" IsDefault="True" Click="SaveButton_Click"
                    Style="{StaticResource DialogPrimaryButton}" Margin="0,0,10,0"/>
            <Button Content="取消" IsCancel="True" Style="{StaticResource DialogGhostButton}"/>
        </StackPanel>
    </Grid>
</Window>
