<Application x:Class="QuickLauncher.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:views="clr-namespace:QuickLauncher.App.Views"
             xmlns:local="clr-namespace:QuickLauncher.App">
    <Application.Resources>

        <!-- ==========================================================
             速动 · 玻璃拟态设计系统 (Glassmorphism)
             ═════════════════════════════════════════════════════════
             设计原则：
               1. 分层透明：窗口底 → 侧栏 → 卡片 → 悬浮层，越靠前越实；
                  背后由 DWM 提供真实毛玻璃模糊（见 Themes/WindowBackdrop.cs）。
               2. 高光描边：每层玻璃上缘有一道高光（GlassHighlight），下缘收暗，
                  这是玻璃厚度感的来源。
               3. 品牌渐变只用在「动作发生的地方」（主按钮、选中态、进度），
                  其余一律中性色，避免花哨。
               4. 文字永远实色（TextPrimary/Secondary/Muted），
                  不放在半透明色块上，保证浅色主题下依然可读。

             【主题切换】所有颜色画笔都是唯一实例，Themes/ThemeManager.cs
             在切换时直接改写这些实例的 Color，所有引用立即生效。
             ========================================================== -->

        <!-- ═════════ 颜色令牌 ═════════
             【为什么画笔的 Color 要走 DynamicResource】
             WPF 会「冻结」被多处共享引用的 Freezable（画笔），冻结后其属性只读，
             运行时改色会抛「指定属性为只读」。给 Color 挂上 DynamicResource 之后，
             画布自身不可冻结，Themes/ThemeManager.cs 才能在切换主题时就地改写颜色。 -->
        <Color x:Key="C.BgBase">#EB0C1018</Color>
        <Color x:Key="C.BgSide">#CB090D14</Color>
        <Color x:Key="C.BgCard">#C4141A26</Color>
        <Color x:Key="C.BgCardHover">#EE1E2638</Color>
        <Color x:Key="C.Scrim">#F610141E</Color>
        <Color x:Key="C.PanelBg">#ED0C1019</Color>
        <Color x:Key="C.Tile">#22FFFFFF</Color>
        <Color x:Key="C.TileEmpty">#10FFFFFF</Color>
        <Color x:Key="C.Stroke">#2EFFFFFF</Color>
        <Color x:Key="C.StrokeStrong">#4AFFFFFF</Color>
        <Color x:Key="C.GlassHighlight">#44FFFFFF</Color>
        <Color x:Key="C.TextPrimary">#FFF8FAFC</Color>
        <Color x:Key="C.TextSecondary">#FF94A3B8</Color>
        <Color x:Key="C.TextMuted">#FF64748B</Color>
        <Color x:Key="C.Brand">#FF38BDF8</Color>
        <Color x:Key="C.Brand2">#FF818CF8</Color>
        <Color x:Key="C.Accent">#FF34D399</Color>
        <Color x:Key="C.Danger">#FFFB7185</Color>
        <Color x:Key="C.Warn">#FFFBBF24</Color>
        <Color x:Key="C.HoverOverlay">#18FFFFFF</Color>
        <Color x:Key="C.PressOverlay">#2CFFFFFF</Color>
        <Color x:Key="C.Grad1">#FF38BDF8</Color>
        <Color x:Key="C.Grad2">#FF6366F1</Color>
        <Color x:Key="C.Grad3">#FFA855F7</Color>
        <Color x:Key="C.GradSoft1">#FF38BDF8</Color>
        <Color x:Key="C.GradSoft2">#FFA855F7</Color>
        <Color x:Key="C.SpecularTop">#3DFFFFFF</Color>
        <Color x:Key="C.SpecularBottom">#00FFFFFF</Color>
        <Color x:Key="C.Bloom1">#FF38BDF8</Color>
        <Color x:Key="C.Bloom1Mid">#8038BDF8</Color>
        <Color x:Key="C.Bloom1End">#0038BDF8</Color>
        <Color x:Key="C.Bloom2">#FFA855F7</Color>
        <Color x:Key="C.Bloom2Mid">#80A855F7</Color>
        <Color x:Key="C.Bloom2End">#00A855F7</Color>
        <Color x:Key="C.Bloom3">#FF22D3EE</Color>
        <Color x:Key="C.Bloom3Mid">#8022D3EE</Color>
        <Color x:Key="C.Bloom3End">#0022D3EE</Color>

        <!-- ═════════ 表面层（半透明，透出背后毛玻璃） ═════════ -->
        <SolidColorBrush x:Key="Brush.BgBase" Color="{DynamicResource C.BgBase}"/>
        <SolidColorBrush x:Key="Brush.BgSide" Color="{DynamicResource C.BgSide}"/>
        <SolidColorBrush x:Key="Brush.BgCard" Color="{DynamicResource C.BgCard}"/>
        <SolidColorBrush x:Key="Brush.BgCardHover" Color="{DynamicResource C.BgCardHover}"/>
        <SolidColorBrush x:Key="Brush.Scrim" Color="{DynamicResource C.Scrim}"/>

        <!-- 悬浮面板与磁贴：比主窗口更透，透出桌面/毛玻璃 -->
        <SolidColorBrush x:Key="Brush.PanelBg" Color="{DynamicResource C.PanelBg}"/>
        <SolidColorBrush x:Key="Brush.Tile" Color="{DynamicResource C.Tile}"/>
        <SolidColorBrush x:Key="Brush.TileEmpty" Color="{DynamicResource C.TileEmpty}"/>

        <!-- ═════════ 描边与高光 ═════════ -->
        <SolidColorBrush x:Key="Brush.Stroke" Color="{DynamicResource C.Stroke}"/>
        <SolidColorBrush x:Key="Brush.StrokeStrong" Color="{DynamicResource C.StrokeStrong}"/>
        <SolidColorBrush x:Key="Brush.GlassHighlight" Color="{DynamicResource C.GlassHighlight}"/>

        <!-- ═════════ 文字 ═════════ -->
        <SolidColorBrush x:Key="Brush.TextPrimary" Color="{DynamicResource C.TextPrimary}"/>
        <SolidColorBrush x:Key="Brush.TextSecondary" Color="{DynamicResource C.TextSecondary}"/>
        <SolidColorBrush x:Key="Brush.TextMuted" Color="{DynamicResource C.TextMuted}"/>

        <!-- ═════════ 品牌与状态色 ═════════ -->
        <SolidColorBrush x:Key="Brush.Brand" Color="{DynamicResource C.Brand}"/>
        <SolidColorBrush x:Key="Brush.Brand2" Color="{DynamicResource C.Brand2}"/>
        <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource C.Accent}"/>
        <SolidColorBrush x:Key="Brush.Danger" Color="{DynamicResource C.Danger}"/>
        <SolidColorBrush x:Key="Brush.Warn" Color="{DynamicResource C.Warn}"/>

        <!-- ═════════ 交互叠加层 ═════════ -->
        <SolidColorBrush x:Key="Brush.HoverOverlay" Color="{DynamicResource C.HoverOverlay}"/>
        <SolidColorBrush x:Key="Brush.PressOverlay" Color="{DynamicResource C.PressOverlay}"/>
        <SolidColorBrush x:Key="Brush.Transparent" Color="Transparent"/>

        <!-- ═════════ 品牌渐变（与图标一致：青蓝 → 蓝 → 紫，135°） ═════════ -->
        <LinearGradientBrush x:Key="Brush.Gradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="{DynamicResource C.Grad1}"/>
            <GradientStop Offset="0.5" Color="{DynamicResource C.Grad2}"/>
            <GradientStop Offset="1" Color="{DynamicResource C.Grad3}"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Brush.GradientSoft" StartPoint="0,0" EndPoint="1,1" Opacity="0.18">
            <GradientStop Offset="0" Color="{DynamicResource C.GradSoft1}"/>
            <GradientStop Offset="1" Color="{DynamicResource C.GradSoft2}"/>
        </LinearGradientBrush>
        <!-- 分隔线：两端渐隐的发光细线 -->
        <LinearGradientBrush x:Key="Brush.Divider" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#00FFFFFF"/>
            <GradientStop Offset="0.5" Color="#59FFFFFF"/>
            <GradientStop Offset="1" Color="#00FFFFFF"/>
        </LinearGradientBrush>

        <!-- 玻璃面板顶部高光：从白到透明，模拟玻璃上缘反射 -->
        <LinearGradientBrush x:Key="Brush.Specular" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="{DynamicResource C.SpecularTop}"/>
            <GradientStop Offset="1" Color="{DynamicResource C.SpecularBottom}"/>
        </LinearGradientBrush>

        <!-- ═════════ 极光色斑（窗口背景的彩色辉光，营造玻璃后的光影） ═════════ -->
        <RadialGradientBrush x:Key="Brush.Bloom1" GradientOrigin="0.5,0.5" Center="0.5,0.5"
                             RadiusX="0.5" RadiusY="0.5">
            <GradientStop Offset="0" Color="{DynamicResource C.Bloom1}"/>
            <GradientStop Offset="0.5" Color="{DynamicResource C.Bloom1Mid}"/>
            <GradientStop Offset="1" Color="{DynamicResource C.Bloom1End}"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="Brush.Bloom2" GradientOrigin="0.5,0.5" Center="0.5,0.5"
                             RadiusX="0.5" RadiusY="0.5">
            <GradientStop Offset="0" Color="{DynamicResource C.Bloom2}"/>
            <GradientStop Offset="0.5" Color="{DynamicResource C.Bloom2Mid}"/>
            <GradientStop Offset="1" Color="{DynamicResource C.Bloom2End}"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="Brush.Bloom3" GradientOrigin="0.5,0.5" Center="0.5,0.5"
                             RadiusX="0.5" RadiusY="0.5">
            <GradientStop Offset="0" Color="{DynamicResource C.Bloom3}"/>
            <GradientStop Offset="0.5" Color="{DynamicResource C.Bloom3Mid}"/>
            <GradientStop Offset="1" Color="{DynamicResource C.Bloom3End}"/>
        </RadialGradientBrush>

        <!-- ==========================================================
             全局字体与继承属性
             ========================================================== -->
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, sans-serif"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>
        <Style TargetType="UserControl">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, sans-serif"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <!-- ==========================================================
             文本样式
             ========================================================== -->
        <Style x:Key="Text.PageTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Text.PageSubtitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Text.Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Text.Subtle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Text.FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ==========================================================
             容器
             ========================================================== -->
        <!-- 玻璃卡片：半透明面 + 细描边 + 上缘高光 + 柔和阴影 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.BgCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="22,18"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.10" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CardDesc" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- 小标签（徽章） -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.BgCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="9,4"/>
        </Style>
        <!-- 键盘按键外观 (Keycap) -->
        <Style x:Key="Kbd" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Tile}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.StrokeStrong}"/>
            <Setter Property="BorderThickness" Value="1,1,1,2"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="KbdText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="FontFamily" Value="Consolas, Cascadia Code, Segoe UI, sans-serif"/>
        </Style>

        <!-- ==========================================================
             按钮
             ========================================================== -->
        <!-- 基础按钮（隐式）：玻璃质感 + hover 提亮 + 按下反馈 -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource Brush.BgCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,7.5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" SnapsToDevicePixels="True">
                            <Grid>
                                <!-- hover/press 叠加层：保留原背景同时提亮 -->
                                <Border x:Name="Overlay" Background="Transparent" CornerRadius="10"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource Brush.HoverOverlay}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.StrokeStrong}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource Brush.PressOverlay}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
                                <Setter Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮：品牌渐变 + 柔光 -->
        <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Brush.Gradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="10" SnapsToDevicePixels="True">
                            <Grid ClipToBounds="True">
                                <Border Background="{DynamicResource Brush.Specular}" CornerRadius="10,10,0,0" Height="14" VerticalAlignment="Top"/>
                                <Border x:Name="Overlay" Background="Transparent" CornerRadius="10"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource Brush.HoverOverlay}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource Brush.PressOverlay}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 危险按钮：淡红玻璃底 + 红字 -->
        <Style x:Key="Btn.Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#22FB7185"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
            <Setter Property="BorderBrush" Value="#4DFB7185"/>
        </Style>

        <!-- 幽灵/次级按钮（透明底） -->
        <Style x:Key="Btn.Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        </Style>

        <!-- 纯文字按钮（工具栏里的次要操作） -->
        <Style x:Key="Btn.Text" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>

        <!-- 图标按钮（方形、用于面板顶栏/窗口按钮） -->
        <Style x:Key="Btn.Icon" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        </Style>

        <!-- 窗口标题栏按钮（最小化/最大化/关闭） -->
        <Style x:Key="Btn.Caption" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        </Style>
        <Style x:Key="Btn.CaptionClose" TargetType="Button" BasedOn="{StaticResource Btn.Caption}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        </Style>

        <!-- ==========================================================
             输入框（含 Tag 水印）
             ========================================================== -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource Brush.BgCard}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.Brand}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Brand}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" SnapsToDevicePixels="True">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                                <TextBlock x:Name="Watermark" Text="{TemplateBinding Tag}"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           Margin="{TemplateBinding Padding}"
                                           IsHitTestVisible="False" Visibility="Collapsed"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.StrokeStrong}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Watermark" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Brand}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==========================================================
             复选框
             ========================================================== -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="5"
                                    Background="{DynamicResource Brush.BgCard}"
                                    BorderBrush="{DynamicResource Brush.StrokeStrong}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Tick" Data="M 4,9 L 7.5,12.5 L 14,5"
                                      Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Visibility="Hidden"/>
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Brand}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Brand}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Brand}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==========================================================
             单选按钮
             ========================================================== -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="18" Height="18" VerticalAlignment="Center">
                                <Ellipse x:Name="Ring" Fill="{DynamicResource Brush.BgCard}"
                                         Stroke="{DynamicResource Brush.StrokeStrong}" StrokeThickness="1"/>
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource Brush.Brand}"
                                         Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Brush.Brand}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Brush.Brand}"/>
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==========================================================
             下拉框
             ========================================================== -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource Brush.BgCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="9" SnapsToDevicePixels="True">
                                            <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,12,0" Data="M 1 3 L 5 7 L 9 3"
                                                  Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=Toggle}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource Brush.Scrim}" BorderBrush="{DynamicResource Brush.Stroke}"
                                        BorderThickness="1" CornerRadius="10" Margin="0,5,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.5"/>
                                    </Border.Effect>
                                    <ScrollViewer Margin="0,5">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Toggle" Property="BorderBrush" Value="{DynamicResource Brush.Brand}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Toggle" Property="BorderBrush" Value="{DynamicResource Brush.Brand}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="border" Background="Transparent" Padding="{TemplateBinding Padding}"
                                CornerRadius="7" SnapsToDevicePixels="True" Margin="4,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.BgCardHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.GradientSoft}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==========================================================
             列表
             ========================================================== -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border" Background="Transparent" Padding="{TemplateBinding Padding}"
                                BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="11" SnapsToDevicePixels="True" Margin="4,2.5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.HoverOverlay}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Brush.Stroke}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.GradientSoft}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Brush.Brand}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==========================================================
             树形列表（步骤选择器）
             ========================================================== -->
        <Style TargetType="TreeView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="header" Background="Transparent" CornerRadius="8"
                                    Padding="4,5" Margin="0,1">
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Margin="16,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="header" Property="Background" Value="{DynamicResource Brush.HoverOverlay}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="header" Property="Background" Value="{DynamicResource Brush.GradientSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==========================================================
             右键菜单 / 菜单项 / 分隔线
             ========================================================== -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource Brush.Scrim}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.55"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="border" Background="Transparent" Padding="{TemplateBinding Padding}"
                                CornerRadius="7" SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.GradientSoft}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{DynamicResource Brush.Stroke}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==========================================================
             提示框
             ========================================================== -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource Brush.Scrim}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==========================================================
             细滚动条（暗色、圆角 thumb、悬停变亮）
             ========================================================== -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="PART_Thumb" Opacity="0.55">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="5" Background="{DynamicResource Brush.TextMuted}"
                                                        Margin="2,1" SnapsToDevicePixels="True"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Thumb" Property="Opacity" Value="0.95"/>
                            </Trigger>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="10"/>
                                <Setter Property="Width" Value="Auto"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==========================================================
             滑块（设置项）
             ========================================================== -->
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Brand}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="20">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource Brush.BgCard}"/>
                            <Border x:Name="PART_SelectionRange" Height="4" CornerRadius="2"
                                    Background="{DynamicResource Brush.Gradient}" HorizontalAlignment="Left"/>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="dot" Fill="White" Stroke="{DynamicResource Brush.Brand}" StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==========================================================
             选项卡（图标选择器等）
             ========================================================== -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" Margin="0,0,0,12"/>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Background="Transparent" Padding="15,7" Margin="0,0,6,0"
                                CornerRadius="9" SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.GradientSoft}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.HoverOverlay}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==========================================================
             弹窗统一外壳
             ═════════════════════════════════════════════════════════
             所有弹窗共用同一个窗口模板：圆角玻璃面板 + 顶部标题条（含关闭按钮），
             弹窗本身只需写「主体内容」，样式自然统一。
             关闭按钮绑定系统命令，无需每个窗口各写一遍事件处理。
             ========================================================== -->
        <Style x:Key="DialogTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DialogCloseButton" TargetType="Button" BasedOn="{StaticResource Btn.Icon}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Command" Value="{x:Static SystemCommands.CloseWindowCommand}"/>
            <Setter Property="CommandTarget" Value="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        </Style>
        <Style x:Key="DialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Padding" Value="18,7"/>
        </Style>
        <Style x:Key="DialogGhostButton" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Padding" Value="18,7"/>
        </Style>

        <ControlTemplate x:Key="DialogShell" TargetType="Window">
            <Border Background="{DynamicResource Brush.BgBase}"
                    BorderBrush="{DynamicResource Brush.StrokeStrong}" BorderThickness="1" CornerRadius="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="36" ShadowDepth="8" Direction="270" Opacity="0.5" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 标题条 -->
                    <Grid Grid.Row="0" Margin="20,16,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="4" Height="14" CornerRadius="2" Background="{DynamicResource Brush.Gradient}" Margin="0,0,10,0"/>
                            <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource DialogTitle}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource DialogCloseButton}"
                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                            <views:IconView Kind="Close" Size="13"/>
                        </Button>
                    </Grid>

                    <!-- 主体 -->
                    <ContentPresenter Grid.Row="1" Margin="20,14,20,20"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"/>
                </Grid>
            </Border>
        </ControlTemplate>

    </Application.Resources>
</Application>
