<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="2.0.0.0" name="QuickLauncher.App" />
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- 默认清单：普通权限（asInvoker），启动不弹 UAC。
             任何人 clone 后 `dotnet build` / `dotnet run` 都能直接运行，无需代码签名、无需管理员权限。

             【UIAccess 是可选增强，不是默认】
             UIAccess（uiAccess="true"）用于在「以管理员运行的窗口」内也能唤出面板、并让 SendInput
             合成输入送达那些窗口（yuzu / 任务管理器 / 某些需要提权的软件）。它有硬前提，缺一即被系统
             忽略；且未签名时 Windows 会直接拒绝启动（错误 740/577）：
               1) 可执行文件已代码签名，且证书链连到「受信任的根证书颁发机构」；
               2) 安装在 C:\Program Files\ 等需要 UAC 提示的安全位置；
               3) 发布者证书在「受信任的发布者」存储中。

             因此 UIAccess 版本单独放在 app.uiaccess.manifest，仅在【签名成功后】产出：
               dotnet publish ... -p:UIAccessManifest=true
             开发机、便携版、以及无证书的普通发布一律使用本文件（uiAccess=false）。

             详见 docs/第2步-UIAccess改造计划.md 与 scripts/ 下各脚本。 -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
